<style>
  .luna-community {
    padding: 58px 16px;
    background:
      radial-gradient(circle at 8% 6%, rgba(75,206,238,.22), transparent 34%),
      radial-gradient(circle at 92% 0%, rgba(242,172,185,.34), transparent 38%),
      linear-gradient(180deg, #fff8fb 0%, #eef9ff 100%);
    overflow: hidden;
  }

  .luna-community__inner {
    max-width: 1220px;
    margin: 0 auto;
  }

  .luna-community__header {
    text-align: center;
    max-width: 850px;
    margin: 0 auto 30px;
  }

  .luna-community__eyebrow {
    margin: 0 0 10px;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: #E6A0AA;
  }

  .luna-community__heading {
    margin: 0 0 14px;
    font-size: 38px;
    line-height: 1.03;
    font-weight: 900;
    color: #111;
  }

  .luna-community__sub {
    margin: 0 auto;
    max-width: 720px;
    font-size: 16px;
    line-height: 1.55;
    color: #555;
  }
.luna-moodboard-rail {
  margin: 34px calc(50% - 50vw) 44px;
  padding: 0 16px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;
}

.luna-moodboard-rail::-webkit-scrollbar {
  display: none;
}

.luna-moodboard-track {
  display: flex;
  gap: 18px;
  width: max-content;
}

.luna-moodboard-slide {
  width: min(86vw, 1040px);
  scroll-snap-align: center;
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  grid-auto-rows: 135px;
  gap: 12px;
}

.mood {
  border-radius: 24px;
  overflow: hidden;
  background: #fff;
  border: 1px solid rgba(230,160,170,.24);
  box-shadow: 0 14px 34px rgba(230,160,170,.11);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 18px;
  text-align: center;
  font-weight: 900;
  color: #111;
}

.mood img,
.mood video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.mood--image,
.mood--video {
  padding: 0;
}

.mood--hero {
  grid-column: span 3;
  grid-row: span 2;
  flex-direction: column;
  align-items: flex-start;
  text-align: left;
  justify-content: flex-end;
}

.mood--hero span {
  font-size: 11px;
  letter-spacing: .15em;
  text-transform: uppercase;
  margin-bottom: 10px;
}

.mood--hero h3 {
  margin: 0;
  font-size: 42px;
  line-height: .98;
  letter-spacing: -.04em;
}

.mood--gradient {
  background: linear-gradient(135deg, #4fccee 0%, #f2acb9 80%);
}

.mood--dark {
  background: #111;
  color: #fff;
}

.mood--word {
  font-size: 34px;
  line-height: .9;
  letter-spacing: -.04em;
}

.mood--mini,
.mood--small {
  font-size: 20px;
  line-height: 1.1;
}

.mood--small {
  grid-column: span 2;
}

.mood--mini {
  grid-column: span 2;
}

.mood--image.tall,
.mood--video.tall {
  grid-row: span 2;
}

.mood--image.wide,
.mood--video.wide {
  grid-column: span 2;
}

.mood--image.tall {
  grid-column: span 2;
}

.mood--blue,
.blue {
  background: #eef9ff;
}

.mood--pink,
.pink {
  background: #FDF4F6;
}

.dark {
  background: #111;
  color: #fff;
}

@media screen and (max-width: 749px) {
  .luna-moodboard-rail {
    padding: 0 14px;
    margin-top: 28px;
  }

  .luna-moodboard-slide {
    width: 86vw;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 104px;
    gap: 10px;
  }

  .mood {
    border-radius: 18px;
    padding: 14px;
  }

  .mood--hero {
    grid-column: span 4;
    grid-row: span 2;
  }

  .mood--hero h3 {
    font-size: 32px;
  }

  .mood--word {
    font-size: 26px;
  }

  .mood--mini,
  .mood--small {
    font-size: 16px;
  }

  .mood--image.tall {
    grid-column: span 2;
    grid-row: span 2;
  }

  .mood--image.wide,
  .mood--video.wide,
  .mood--small,
  .mood--mini {
    grid-column: span 2;
  }
}

  .luna-review-section-title {
    text-align: center;
    margin: 10px auto 18px;
  }

  .luna-review-section-title p {
    margin: 0 0 8px;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: #E6A0AA;
  }

  .luna-review-section-title h3 {
    margin: 0;
    font-size: 30px;
    line-height: 1.08;
    font-weight: 900;
    color: #111;
  }

  .luna-review-rail {
    display: flex;
    gap: 14px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 4px 2px 16px;
    -webkit-overflow-scrolling: touch;
  }

  .luna-review-rail::-webkit-scrollbar {
    display: none;
  }

  .luna-review-card {
    flex: 0 0 84%;
    scroll-snap-align: start;
    background: #fff;
    border: 1px solid rgba(230,160,170,.24);
    border-radius: 24px;
    padding: 20px;
    box-shadow: 0 14px 34px rgba(230,160,170,.11);
  }

  .luna-review-card__stars {
    color: #E6A0AA;
    font-size: 16px;
    letter-spacing: .06em;
    margin-bottom: 10px;
  }

  .luna-review-card__product {
    display: inline-flex;
    margin-bottom: 12px;
    padding: 7px 10px;
    border-radius: 999px;
    background: #FDF4F6;
    border: 1px solid rgba(230,160,170,.38);
    font-size: 10px;
    font-weight: 900;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: #111;
  }

  .luna-review-card h4 {
    margin: 0 0 10px;
    font-size: 20px;
    line-height: 1.1;
    font-weight: 900;
    color: #111;
  }

  .luna-review-card p {
    margin: 0 0 16px;
    font-size: 14px;
    line-height: 1.48;
    color: #555;
  }

  .luna-review-card__author {
    font-size: 13px;
    font-weight: 900;
    color: #111;
  }

  .luna-review-card__source {
    margin-top: 4px;
    font-size: 12px;
    color: #777;
  }

  @media screen and (min-width: 900px) {
    .luna-community {
      padding: 78px 48px;
    }

    .luna-community__heading {
      font-size: 54px;
    }

    .luna-wall {
      grid-template-columns: repeat(6, 1fr);
      grid-auto-rows: 150px;
      gap: 14px;
    }

    .luna-wall__tile {
      min-height: auto;
    }

    .luna-wall__tile--wide {
      grid-column: span 3;
    }

    .luna-wall__tile--mid {
      grid-column: span 2;
    }

    .luna-wall__tile--big {
      grid-column: span 3;
      grid-row: span 2;
    }

    .luna-wall__tile--image {
      grid-column: span 2;
      grid-row: span 2;
    }

    .luna-review-card {
      flex: 0 0 31%;
      min-height: 310px;
    }
  }
</style>

