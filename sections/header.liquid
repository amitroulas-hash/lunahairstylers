{{ 'component-menu-drawer.css' | asset_url | stylesheet_tag }}
{{ 'component-cart-notification.css' | asset_url | stylesheet_tag }}
{{ 'component-cart-items.css' | asset_url | stylesheet_tag }}
{{ 'section-header.css' | asset_url | stylesheet_tag }}

{%- if settings.predictive_search_enabled -%}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'component-loading-overlay.css' | asset_url | stylesheet_tag }}
{%- endif -%}
<style>
/* ===== LUNA HEADER + MEGA MENU CLEAN VERSION ===== */

/*
  Keep the Luna header above all homepage storytelling/sticky sections
  on both desktop and mobile. Some Luna sections create their own
  stacking contexts, so Dawn's default z-index: 3 is not sufficient.
*/
#shopify-section-header,
#shopify-section-header.shopify-section-header-sticky,
#shopify-section-header.animate {
  z-index: 1000 !important;
}

#shopify-section-header .header-wrapper,
#shopify-section-header sticky-header {
  position: relative;
  z-index: 1000 !important;
}

#shopify-section-header .menu-drawer,
#shopify-section-header .luna-header-mega {
  z-index: 1100 !important;
}

.header__inline-menu ul,
.header__inline-menu li,
.menu-drawer__menu,
.menu-drawer__menu li {
  list-style: none;
  margin: 0;
  padding: 0;
}

.header__inline-menu summary::-webkit-details-marker,
.menu-drawer summary::-webkit-details-marker {
  display: none;
}

/* DESKTOP */
@media screen and (min-width: 990px) {
  header-drawer,
  .menu-drawer-container,
  .header__icon--menu {
    display: none !important;
  }

  .header {
    position: relative !important;
    display: grid !important;
    grid-template-areas:
      "search logo icons"
      "nav nav nav" !important;
    grid-template-columns: 1fr auto 1fr !important;
    row-gap: 10px !important;
    column-gap: 24px !important;
    align-items: center !important;
    padding-top: 16px !important;
    padding-bottom: 14px !important;
  }

  .header__heading,
  .header__heading-link {
    grid-area: logo !important;
    justify-self: center !important;
    align-self: center !important;
    margin: 0 !important;
    line-height: 0 !important;
  }

  .header__heading-logo {
    display: block !important;
    max-width: 78px !important;
    width: auto !important;
    height: auto !important;
  }

  .header__icons {
    grid-area: icons !important;
    justify-self: end !important;
    display: flex !important;
    align-items: center !important;
    gap: 18px !important;
  }

  .header__icons .header__search {
    display: inline-flex !important;
  }

  .header__inline-menu {
    grid-area: nav !important;
    display: block !important;
    justify-self: center !important;
    width: 100% !important;
    margin: 0 !important;
  }

  .header__inline-menu .list-menu--inline {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    flex-wrap: nowrap !important;
    gap: 34px !important;
  }

  .header__inline-menu .list-menu--inline > li {
    position: relative;
  }

  .header__inline-menu .list-menu--inline > li.luna-menu-item-shopall {
    position: static;
  }

  .header__menu-item {
    display: inline-flex !important;
    align-items: center !important;
    gap: 6px !important;
    font-size: 13px !important;
    font-weight: 700 !important;
    letter-spacing: 0.02em !important;
    text-decoration: none !important;
    padding: 8px 0 !important;
  }

  .luna-desktop-shopall,
  .luna-desktop-shopall > details {
    position: static;
  }

  .luna-desktop-shopall > details > summary {
    display: inline-flex !important;
    align-items: center;
    gap: 7px;
    padding: 10px 14px !important;
    border-radius: 999px;
    transition: background 0.22s ease, box-shadow 0.22s ease;
  }

  .luna-desktop-shopall > details > summary:hover,
  .luna-desktop-shopall > details[open] > summary {
    background: rgba(255,255,255,0.58);
    box-shadow: 0 8px 20px rgba(230,160,170,0.12);
  }

  .header__submenu.luna-header-mega {
    position: absolute;
    z-index: 60;
    display: block !important;
    min-width: 980px;
    max-width: 1120px;
    width: min(1120px, calc(100vw - 80px));
    left: 50%;
    top: calc(100% + 12px);
    padding: 0;
    border: none;
    background: transparent;
    box-shadow: none;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    translate: -50% 0;
    transform: translateY(10px) scale(0.985);
    transform-origin: top center;
    transition: opacity 0.22s ease, transform 0.22s ease, visibility 0.22s ease;
  }

  .header__submenu.luna-header-mega::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: -18px;
    height: 18px;
  }

  .luna-desktop-shopall > details[open] > .luna-header-mega {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0) scale(1);
  }

  .luna-mega-panel {
    background: linear-gradient(180deg, #ffffff 0%, #fff8fb 100%);
    border: 1px solid rgba(230,160,170,0.18);
    border-radius: 24px;
    box-shadow: 0 24px 60px rgba(17,17,17,0.10);
    overflow: hidden;
    padding: 18px;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .luna-mega-panel__inner {
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr);
    gap: 18px;
    align-items: stretch;
  }

  .luna-mega-panel__feature {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }

  .luna-mega-panel__links {
    min-width: 0;
  }

  .luna-mega-panel__links-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }

  .luna-mega-panel__eyebrow {
    display: inline-block;
    margin: 0 0 8px;
    font-size: 10px;
    line-height: 1;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #7a5a68;
  }

  .luna-mega-panel__headline {
    margin: 0 0 8px;
    font-size: 24px;
    line-height: 1.02;
    letter-spacing: -0.03em;
    font-weight: 800;
    color: #111;
  }

  .luna-mega-panel__sub {
    margin: 0 0 12px;
    font-size: 13px;
    line-height: 1.5;
    color: #555;
  }

  .luna-mega-panel__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .luna-mega-panel__chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 8px 10px;
    border-radius: 999px;
    background: rgba(255,255,255,0.82);
    border: 1px solid rgba(230,160,170,0.22);
    font-size: 10px;
    line-height: 1.1;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #111;
  }

  .luna-nav-card {
    display: block;
    background: #fff;
    border: 1px solid rgba(230,160,170,0.16);
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 10px 24px rgba(230,160,170,0.06);
    height: 100%;
    text-decoration: none;
    transition: transform 0.24s ease, box-shadow 0.24s ease, border-color 0.24s ease;
  }

  .luna-nav-card:hover {
    transform: translateY(-3px);
    border-color: rgba(230,160,170,0.34);
    box-shadow: 0 16px 30px rgba(230,160,170,0.12);
  }

  .luna-nav-card__media {
    position: relative;
    aspect-ratio: 1 / 0.78;
    overflow: hidden;
    background: linear-gradient(135deg, #f8d6e7 0%, #d8dffb 100%);
  }

  .luna-nav-card__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .luna-nav-card__badge {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 2;
    padding: 8px 10px;
    border-radius: 999px;
    background: rgba(255,255,255,0.78);
    border: 1px solid rgba(255,255,255,0.5);
    color: #111;
    font-size: 10px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .luna-nav-card__content {
    padding: 13px 13px 15px;
  }

  .luna-nav-card__title {
    margin: 0 0 6px;
    font-size: 16px;
    line-height: 1.08;
    font-weight: 800;
    color: #111;
  }

  .luna-nav-card__caption {
    margin: 0;
    font-size: 12.5px;
    line-height: 1.4;
    color: #555;
  }
}

/* MOBILE */
@media screen and (max-width: 989px) {
  /*
    Keep the mobile header and drawer above hero / sticky story sections.
    The Luna hero intentionally overlaps the next section, so the header
    needs its own stronger stacking context.
  */
  #shopify-section-header,
  #shopify-section-header.shopify-section-header-sticky,
  #shopify-section-header.animate {
    z-index: 1000 !important;
  }

  #shopify-section-header .header-wrapper,
  #shopify-section-header sticky-header {
    position: relative;
    z-index: 1000 !important;
  }

  #shopify-section-header .menu-drawer {
    z-index: 1100 !important;
  }

  #shopify-section-header menu-drawer > details > summary::before {
    z-index: 1090 !important;
  }

  .header__inline-menu {
    display: none !important;
  }

  header-drawer,
  .menu-drawer-container,
  .header__icon--menu {
    display: block !important;
  }

  .header {
    display: grid !important;
    grid-template-areas: "menu logo icons" !important;
    grid-template-columns: 1fr auto 1fr !important;
    align-items: center !important;
    padding-top: 16px !important;
    padding-bottom: 16px !important;
  }

  header-drawer {
    grid-area: menu !important;
    justify-self: start !important;
  }

  .header__heading,
  .header__heading-link {
    grid-area: logo !important;
    justify-self: center !important;
    margin: 0 !important;
    line-height: 0 !important;
  }

  .header__heading-logo {
    max-width: 58px !important;
    height: auto !important;
  }

  .header__icons {
    grid-area: icons !important;
    justify-self: end !important;
    display: flex !important;
    align-items: center !important;
    gap: 12px !important;
  }

  .header__search {
    display: inline-flex !important;
  }

  .menu-drawer__navigation {
    padding-top: 6px;
  }

  .menu-drawer__menu > li {
    border-bottom: 1px solid rgba(0,0,0,0.06);
  }

  .menu-drawer__menu-item {
    font-size: 15px;
    font-weight: 700;
    padding-top: 14px !important;
    padding-bottom: 14px !important;
  }

  .menu-drawer__inner-container {
    background: linear-gradient(180deg, #ffffff 0%, #fff8fb 100%);
  }

  .luna-mobile-drawer-visual {
    padding: 14px 16px 8px;
  }

  .luna-mobile-drawer-visual__intro {
    margin: 0 0 12px;
  }

  .luna-mobile-drawer-visual__eyebrow {
    display: inline-block;
    margin: 0 0 6px;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #7a5a68;
  }

  .luna-mobile-drawer-visual__headline {
    margin: 0;
    font-size: 22px;
    line-height: 1.02;
    font-weight: 800;
    color: #111;
  }

  .luna-mobile-drawer-visual__featured {
    margin: 0 0 12px;
  }

  .luna-mobile-drawer-visual__featured .luna-nav-card__media {
    aspect-ratio: 1.6 / 1;
  }

  .luna-mobile-drawer-visual__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .luna-mobile-drawer-visual .luna-nav-card {
    display: block;
    background: #fff;
    border: 1px solid rgba(230,160,170,0.16);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 10px 24px rgba(230,160,170,0.06);
    height: 100%;
    text-decoration: none;
  }

  .luna-mobile-drawer-visual .luna-nav-card__media {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: linear-gradient(135deg, #f8d6e7 0%, #d8dffb 100%);
  }

  .luna-mobile-drawer-visual .luna-nav-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .luna-mobile-drawer-visual .luna-nav-card__badge {
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 2;
    padding: 7px 9px;
    border-radius: 999px;
    background: rgba(255,255,255,0.82);
    color: #111;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .luna-mobile-drawer-visual .luna-nav-card__content {
    padding: 12px 12px 14px;
  }

  .luna-mobile-drawer-visual .luna-nav-card__title {
    margin: 0 0 5px;
    font-size: 15px;
    line-height: 1.08;
    font-weight: 800;
    color: #111;
  }

  .luna-mobile-drawer-visual .luna-nav-card__caption {
    margin: 0;
    font-size: 12px;
    line-height: 1.4;
    color: #555;
  }
}
/* REMOVE DUPLICATE SEARCH ICON (the floating one) */
.header > details-modal.header__search {
  display: none !important;
}
/* ===== DESKTOP MEGA MENU TUNING ===== */
@media screen and (min-width: 990px) {

  .luna-mega-panel__inner {
    grid-template-columns: 360px minmax(0, 1fr) !important;
  }

  .luna-mega-panel__headline {
    font-size: 22px !important;
  }

  .luna-mega-panel__sub {
    font-size: 12px !important;
  }

  .luna-mega-panel__chip {
    font-size: 9px !important;
    padding: 7px 9px !important;
  }

  .luna-mega-panel__feature {
    gap: 10px !important;
  }

}
/* ===== MOBILE DRAWER VISUAL CLEANUP ===== */
@media screen and (max-width: 989px) {
  .luna-mobile-drawer-visual {
    padding: 22px 18px 12px !important;
  }

  .luna-mobile-drawer-visual__headline {
    font-size: 32px !important;
    line-height: 1.05 !important;
    margin-bottom: 22px !important;
  }

  .luna-mobile-drawer-visual__featured {
    margin-bottom: 18px !important;
  }

  .luna-mobile-drawer-visual__featured .luna-nav-card__media {
    aspect-ratio: 1 / 0.82 !important;
  }

  .luna-mobile-drawer-visual__grid {
    grid-template-columns: 1fr 1fr !important;
    gap: 12px !important;
  }

  .luna-mobile-drawer-visual .luna-nav-card__media {
    aspect-ratio: 1 / 0.9 !important;
  }

  .luna-mobile-drawer-visual .luna-nav-card__title {
    font-size: 20px !important;
    line-height: 1.08 !important;
  }

  .luna-mobile-drawer-visual .luna-nav-card__caption {
    font-size: 16px !important;
    line-height: 1.35 !important;
  }

  .menu-drawer__navigation {
    padding-top: 20px !important;
  }

  .menu-drawer__menu-item {
    font-size: 20px !important;
    padding: 18px 30px !important;
  }
}
/* Hair Dryer rotating nav image */
.luna-nav-card__rotator {
  position: absolute;
  inset: 0;
}

.luna-nav-card__image--rotate {
  position: absolute;
  inset: 0;
  opacity: 0;
  animation: lunaNavImageRotate 6s infinite;
}

.luna-nav-card__image--rotate.is-1 {
  opacity: 1;
}

.luna-nav-card__image--rotate.is-2 {
  animation-delay: 3s;
}

.luna-nav-card__free-badge {
  position: absolute;
  right: 10px;
  bottom: 10px;
  z-index: 3;
  padding: 7px 9px;
  border-radius: 999px;
  background: #E6A0AA;
  color: #fff;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: .08em;
  text-transform: uppercase;
}

@keyframes lunaNavImageRotate {
  0%, 45% { opacity: 1; }
  50%, 100% { opacity: 0; }
}
@media screen and (min-width: 990px) {
  .luna-nav-card__image--rotate.is-2,
  .luna-nav-card__free-badge {
    display: none !important;
  }

  .luna-nav-card__image--rotate.is-1 {
    opacity: 1 !important;
    animation: none !important;
  }
}
</style>

<script src="{{ 'details-disclosure.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'details-modal.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'cart-notification.js' | asset_url }}" defer="defer"></script>

<svg xmlns="http://www.w3.org/2000/svg" class="hidden">
  <symbol id="icon-search" viewbox="0 0 18 19" fill="none">
    <path fill-rule="evenodd" clip-rule="evenodd" d="M11.03 11.68A5.784 5.784 0 112.85 3.5a5.784 5.784 0 018.18 8.18zm.26 1.12a6.78 6.78 0 11.72-.7l5.4 5.4a.5.5 0 11-.71.7l-5.41-5.4z" fill="currentColor"/>
  </symbol>

  <symbol id="icon-close" class="icon icon-close" fill="none" viewBox="0 0 18 17">
    <path d="M.865 15.978a.5.5 0 00.707.707l7.433-7.431 7.579 7.282a.501.501 0 00.846-.37.5.5 0 00-.153-.351L9.712 8.546l7.417-7.416a.5.5 0 10-.707-.708L8.991 7.853 1.413.573a.5.5 0 10-.693.72l7.563 7.268-7.418 7.417z" fill="currentColor">
  </symbol>
</svg>
<{% if section.settings.enable_sticky_header %}sticky-header{% else %}div{% endif %} class="header-wrapper color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_line_separator %} header-wrapper--border-bottom{% endif %}">
  <header class="header header--{{ section.settings.logo_position }} page-width{% if section.settings.menu != blank %} header--has-menu{% endif %}">
    {%- if section.settings.menu != blank -%}
      <header-drawer data-breakpoint="tablet">
        <details class="menu-drawer-container">
          <summary class="header__icon header__icon--menu header__icon--summary link focus-inset" aria-label="{{ 'sections.header.menu' | t }}">
            <span>
              {% render 'icon-hamburger' %}
              {% render 'icon-close' %}
            </span>
          </summary>
          <div id="menu-drawer" class="menu-drawer motion-reduce" tabindex="-1">
            <div class="menu-drawer__inner-container">
              <div class="menu-drawer__navigation-container">
 {% liquid
  assign mobile_featured_link = blank

  for link in section.settings.menu.links
    if link.title == 'Hair Dryer'
      assign mobile_featured_link = link
      break
    endif
  endfor

  if mobile_featured_link == blank
    for link in section.settings.menu.links
      if link.title == 'Hair Dryer'
        assign mobile_featured_link = link
        break
      endif
    endfor
  endif

  if mobile_featured_link == blank
    for link in section.settings.menu.links
      if link.title != 'Shop All'
        assign mobile_featured_link = link
        break
      endif
    endfor
  endif
%}

<div class="luna-mobile-drawer-visual">
  <div class="luna-mobile-drawer-visual__intro">
    <span class="luna-mobile-drawer-visual__eyebrow">Explore the range</span>
    <h3 class="luna-mobile-drawer-visual__headline">Find your Luna tool fast.</h3>
  </div>

  {% if mobile_featured_link != blank %}
    <div class="luna-mobile-drawer-visual__featured">
      {% render 'nav-card', nav_link: mobile_featured_link %}
    </div>
  {% endif %}

   <div class="luna-mobile-drawer-visual__grid">
  {%- for link in section.settings.menu.links -%}
        {%- if link.title == 'Offers' or link.title contains 'Luxe' -%}
      {% continue %}
    {%- endif -%}
    {%- if mobile_featured_link != blank and link.title == mobile_featured_link.title and link.url == mobile_featured_link.url -%}
      {% continue %}
    {%- endif -%}

    {% render 'nav-card', nav_link: link %}

    {%- assign mobile_grid_count = mobile_grid_count | default: 0 | plus: 1 -%}
    {%- if mobile_grid_count >= 4 -%}
      {% break %}
    {%- endif -%}
  {%- endfor -%}
</div>
</div>
                <nav class="menu-drawer__navigation">
                  <ul class="menu-drawer__menu list-menu" role="list">
                   {%- for link in section.settings.menu.links -%}
  {%- if link.title == 'Offers' or link.title contains 'Luxe' -%}
    {% continue %}
  {%- endif -%}
  <li>
                        {%- if link.links != blank -%}
                          <details>
                            <summary class="menu-drawer__menu-item list-menu__item link link--text focus-inset{% if link.child_active %} menu-drawer__menu-item--active{% endif %}">
                              {{ link.title | replace: ' + FREE Kit', '' | replace: ' + FREE KIT', '' | escape }}
                              {% render 'icon-arrow' %}
                              {% render 'icon-caret' %}
                            </summary>
                            <div id="link-{{ link.title | replace: ' + FREE Kit', '' | replace: ' + FREE KIT', '' | escape }}" class="menu-drawer__submenu motion-reduce" tabindex="-1">
                              <div class="menu-drawer__inner-submenu">
                                <button class="menu-drawer__close-button link link--text focus-inset" aria-expanded="true">
                                  {% render 'icon-arrow' %}
                                  {{ link.title | replace: ' + FREE Kit', '' | replace: ' + FREE KIT', '' | escape }}
                                </button>
                                <ul class="menu-drawer__menu list-menu" role="list" tabindex="-1">
                                  {%- for childlink in link.links -%}
                                    <li>
                                      {%- if childlink.links == blank -%}
                                        <a href="{{ childlink.url }}" class="menu-drawer__menu-item link link--text list-menu__item focus-inset{% if childlink.current %} menu-drawer__menu-item--active{% endif %}"{% if childlink.current %} aria-current="page"{% endif %}>
                                          {{ childlink.title | replace: ' + FREE Kit', '' | replace: ' + FREE KIT', '' | escape }}
                                        </a>
                                      {%- else -%}
                                        <details>
                                          <summary class="menu-drawer__menu-item link link--text list-menu__item focus-inset">
                                            {{ childlink.title | replace: ' + FREE Kit', '' | replace: ' + FREE KIT', '' | escape }}
                                            {% render 'icon-arrow' %}
                                            {% render 'icon-caret' %}
                                          </summary>
