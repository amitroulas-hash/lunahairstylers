  }
}

/* Luna Spotlight — final mobile flow polish */
@media screen and (max-width: 549px) {
  .luna-spotlight__visual-{{ section.id }},
  .luna-spotlight__visual-{{ section.id }} img,
  .luna-spotlight__visual-placeholder-{{ section.id }} {
    min-height: 245px;
  }

  .luna-spotlight__caption-{{ section.id }} {
    bottom: 12px;
    padding: 11px 13px;
    font-size: 17px;
    line-height: 1.05;
  }

  .luna-spotlight__story-{{ section.id }} {
    padding: 24px 16px 76px;
  }

  .luna-spotlight__badge-{{ section.id }} {
    margin-bottom: 14px;
  }

  .luna-spotlight__product-stage-{{ section.id }} {
    width: min(220px, 68%);
    margin-bottom: 14px;
  }

  .luna-spotlight__title-{{ section.id }} {
    font-size: 29px;
    line-height: 1;
  }

  .luna-spotlight__hook-{{ section.id }} {
    margin-top: 12px;
    font-size: 14.5px;
    line-height: 1.32;
  }

  .luna-spotlight__bullets-{{ section.id }} {
    margin-top: 16px;
  }

  .luna-spotlight__cta-{{ section.id }} {
    margin-top: 18px;
    min-height: 48px;
  }

  .luna-spotlight__dots-{{ section.id }} {
    bottom: 18px;
  }
}
/* Luna Spotlight — mobile hierarchy clean-up */
@media screen and (max-width: 749px) {
  .luna-spotlight__caption-{{ section.id }} {
    display: none;
  }

  .luna-spotlight__badge-{{ section.id }} {
    margin: 0 0 16px;
    padding: 0;
    background: transparent;
    border: 0;
    color: #9d6b79;
    font-size: 11px;
    line-height: 1.1;
    letter-spacing: .18em;
    box-shadow: none;
  }

  .luna-spotlight__story-{{ section.id }} {
    padding-top: 28px;
  }

  .luna-spotlight__product-stage-{{ section.id }} {
    margin-top: 0;
  }
}
@media (prefers-reduced-motion: reduce) {
  .luna-spotlight__product-stage-{{ section.id }},
  .luna-spotlight__tape-track-{{ section.id }} {
    animation: none !important;
  }

  .luna-spotlight__cta-{{ section.id }} {
    transition: none !important;
  }
}
</style>

<script>
(function() {
  var section = document.querySelector('#luna-spotlight-{{ section.id }}');
  if (!section) return;

  var slides = section.querySelectorAll('.luna-spotlight__slide-{{ section.id }}');
  var dots = section.querySelectorAll('.luna-spotlight__dot-{{ section.id }}');
  var prev = section.querySelector('.luna-spotlight__arrow--prev-{{ section.id }}');
  var next = section.querySelector('.luna-spotlight__arrow--next-{{ section.id }}');
  var current = 0;

  function showSlide(index) {
    if (!slides.length) return;

    if (index < 0) index = slides.length - 1;
    if (index >= slides.length) index = 0;

    slides.forEach(function(slide) {
      slide.classList.remove('is-active');
    });

    dots.forEach(function(dot) {
      dot.classList.remove('is-active');
    });

    slides[index].classList.add('is-active');

    if (dots[index]) {
      dots[index].classList.add('is-active');
    }

    current = index;
  }

  if (prev) {
    prev.addEventListener('click', function() {
      showSlide(current - 1);
    });
  }

  if (next) {
    next.addEventListener('click', function() {
      showSlide(current + 1);
    });
  }

  dots.forEach(function(dot) {
    dot.addEventListener('click', function() {
      var index = parseInt(dot.dataset.dotIndex, 10);
      if (!isNaN(index)) showSlide(index);
    });
  });
})();
</script>

