<style>
  .luna-features {
    padding: 50px 16px;
    background:
      radial-gradient(circle at 10% 0%, rgba(75,206,238,.22), transparent 34%),
      radial-gradient(circle at 90% 6%, rgba(242,172,185,.34), transparent 38%),
      linear-gradient(180deg, #fff8fb 0%, #eef9ff 100%);
  }

  .luna-features__inner {
    max-width: 1180px;
    margin: 0 auto;
  }

  .luna-features__header {
    text-align: center;
    max-width: 860px;
    margin: 0 auto 32px;
  }

  .luna-features__eyebrow {
    margin: 0 0 10px;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: #E6A0AA;
  }

  .luna-features__heading {
    margin: 0 0 14px;
    font-size: 36px;
    line-height: 1.02;
    font-weight: 900;
    color: #111;
  }

  .luna-features__sub {
    margin: 0 auto;
    max-width: 760px;
    font-size: 16px;
    line-height: 1.55;
    color: #555;
  }

  .luna-features__brand-strip {
    margin: 0 0 24px;
    padding: 22px;
    border-radius: 26px;
    background: linear-gradient(135deg, rgba(79,204,238,.9), rgba(242,172,185,.9));
    box-shadow: 0 18px 42px rgba(230,160,170,.16);
  }

  .luna-features__brand-strip h3 {
    margin: 0 0 8px;
    font-size: 28px;
    line-height: 1.05;
    font-weight: 900;
    color: #111;
  }

  .luna-features__brand-strip p {
    margin: 0;
    max-width: 780px;
    font-size: 15px;
    line-height: 1.5;
    color: rgba(17,17,17,.72);
  }

  .luna-features__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
  }

  .luna-features__card {
    background: #fff;
    border: 1px solid rgba(230,160,170,.22);
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 16px 36px rgba(230,160,170,.12);
  }

  .luna-features__media {
    aspect-ratio: 4 / 5;
    background: #fff;
    overflow: hidden;
  }

  .luna-features__media img,
  .luna-features__media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .luna-features__media--results {
    aspect-ratio: 3 / 2;
    background: #fff;
  }

  .luna-features__media--results img {
    object-fit: contain;
    object-position: center center;
    transform: none;
  }

  .luna-features__media--tech img {
    object-fit: contain;
    background: #fff;
  }

  .luna-features__copy {
    padding: 20px;
  }

  .luna-features__badge {
    display: inline-flex;
    margin-bottom: 12px;
    padding: 8px 12px;
    border-radius: 999px;
    background: #FDF4F6;
    border: 1px solid rgba(230,160,170,.45);
    font-size: 10px;
    font-weight: 900;
    letter-spacing: .09em;
    text-transform: uppercase;
    color: #111;
  }

  .luna-features__title {
    margin: 0 0 10px;
    font-size: 25px;
    line-height: 1.08;
    font-weight: 900;
    color: #111;
  }

  .luna-features__text {
    margin: 0 0 14px;
    font-size: 15px;
    line-height: 1.5;
    color: #555;
  }

  .luna-features__bullets {
    display: grid;
    gap: 8px;
    margin: 0 0 16px;
    padding: 0;
    list-style: none;
  }

  .luna-features__bullets li {
    font-size: 13px;
    line-height: 1.35;
    color: #333;
    font-weight: 700;
  }

  .luna-features__bullets li::before {
    content: "✦";
    color: #E6A0AA;
    margin-right: 7px;
  }

  .luna-features__link {
    font-size: 13px;
    font-weight: 900;
    color: #111;
    text-decoration: underline;
    text-decoration-color: #E6A0AA;
    text-decoration-thickness: 3px;
    text-underline-offset: 4px;
  }

  .luna-features__mini-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 18px;
  }

  .luna-features__mini {
    border-radius: 18px;
    overflow: hidden;
    background: #fff;
    border: 1px solid rgba(230,160,170,.22);
    box-shadow: 0 10px 24px rgba(230,160,170,.10);
  }

  .luna-features__mini-media {
    aspect-ratio: 1 / 1.18;
    overflow: hidden;
    background: #fff;
  }

  .luna-features__mini-media video,
  .luna-features__mini-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .luna-features__mini-caption {
    padding: 12px;
    font-size: 13px;
    font-weight: 900;
    line-height: 1.2;
    color: #111;
  }

  .luna-features__proof-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
    margin-top: 18px;
  }

  .luna-features__proof {
    background: rgba(255,255,255,.9);
    border: 1px solid rgba(230,160,170,.22);
    border-radius: 20px;
    padding: 20px;
  }

  .luna-features__proof strong {
    display: block;
    margin-bottom: 6px;
    font-size: 17px;
    color: #111;
  }

  .luna-features__proof span {
    display: block;
    font-size: 14px;
    line-height: 1.45;
    color: #555;
  }

  .luna-features__closing {
    margin-top: 20px;
    padding: 26px 20px;
    border-radius: 26px;
    background: linear-gradient(135deg, #d8dffb 0%, #f2acb9 100%);
    color: #fff;
    text-align: center;
  }

  .luna-features__closing h3 {
    margin: 0 0 8px;
    font-size: 28px;
    line-height: 1.08;
    font-weight: 900;
    color: #111;
  }

  .luna-features__closing p {
    margin: 0 auto 16px;
    max-width: 720px;
    font-size: 15px;
    line-height: 1.5;
    color: #333;
  }

  .luna-features__cta {
  display: inline-flex;
  min-height: 44px;
  align-items: center;
  justify-content: center;
  padding: 12px 22px;
  border-radius: 999px;
  background: #111;
  color: #fff !important;
  font-size: 14px;
  font-weight: 900;
  text-decoration: none;
  box-shadow: 0 10px 24px rgba(17,17,17,.18);
}
.luna-features__cta:hover,
.luna-features__cta:focus {
  background: #E6A0AA !important;
  color: #fff !important;
  transform: translateY(-2px);
}

.luna-features__cta:visited {
  color: #fff !important;
}
  @media screen and (min-width: 900px) {
    .luna-features {
      padding: 68px 48px;
    }

    .luna-features__heading {
      font-size: 48px;
    }

    .luna-features__brand-strip {
      padding: 30px;
    }

    .luna-features__brand-strip h3 {
      font-size: 38px;
    }

    .luna-features__grid {
      grid-template-columns: 1.05fr .95fr;
      align-items: start;
    }

    .luna-features__media {
      aspect-ratio: 1 / .82;
    }

    .luna-features__media--results {
      aspect-ratio: 3 / 2;
    }

    .luna-features__media--results img {
      object-fit: contain;
      object-position: center center;
      transform: none;
    }

    .luna-features__proof-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>

<section class="luna-features">
  <div class="luna-features__inner">

    <div class="luna-features__header">
      <p class="luna-features__eyebrow">Luna performance story</p>
      <h2 class="luna-features__heading">Glossy results. Smart technology. Everyday prices.</h2>
      <p class="luna-features__sub">
        Luna exists for women who want their hair to look good without overthinking it — smart tech, real routines, glossy results and everyday pricing that makes sense.
      </p>
    </div>

    <div class="luna-features__brand-strip">
      <h3>Good hair should feel fun, easy and accessible.</h3>
      <p>
        High-impact hair tools for real bathrooms, real routines and real hair days. Argan Oil ceramic styling, ionic drying power and value that does not feel basic.
      </p>
    </div>

    <div class="luna-features__grid">

      <div>
        <div class="luna-features__card">
          <div class="luna-features__media luna-features__media--results">
