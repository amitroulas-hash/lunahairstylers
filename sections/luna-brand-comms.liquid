            <div class="luna-features__mini-media">
              <video autoplay muted loop playsinline preload="metadata">
                <source src="https://cdn.shopify.com/videos/c/o/v/f0e4929d939144d0bf1213959d1bded1.mp4" type="video/mp4">
              </video>
            </div>
            <div class="luna-features__mini-caption">Curler quick result</div>
          </div>

          <div class="luna-features__mini">
            <div class="luna-features__mini-media">
              <video autoplay muted loop playsinline preload="metadata">
                <source src="https://cdn.shopify.com/videos/c/o/v/e95390ada9cc4e95afa0403c1d44da5f.mp4" type="video/mp4">
              </video>
            </div>
            <div class="luna-features__mini-caption">Straightener in action</div>
          </div>
        </div>
      </div>

      <div>
        <div class="luna-features__card">
          <div class="luna-features__media">
            <img src="https://cdn.shopify.com/s/files/1/0609/7426/8657/files/Straightner_results_for_product_page_4x_7f610f45-5ff8-47ec-9aa3-409afeaef3af.png?v=1776417221" alt="Luna dryer smooth results" loading="lazy">
          </div>
          <div class="luna-features__copy">
            <span class="luna-features__badge">Visible Results</span>
            <h3 class="luna-features__title">Designed for everyday shine, control and confidence.</h3>
            <p class="luna-features__text">
              From quick smoothing to fresh blow-dry energy, Luna is built for hair that feels easy, wearable and confident.
            </p>
