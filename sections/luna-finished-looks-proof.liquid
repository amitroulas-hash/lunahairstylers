    {% assign has_review_blocks = false %}
    {% for block in section.blocks %}
      {% if block.type == 'review' %}
        {% assign has_review_blocks = true %}
      {% endif %}
    {% endfor %}

    <div class="luna-finished-proof__reviews-{{ section.id }}">
      {% if has_review_blocks %}
        {% for block in section.blocks %}
          {% if block.type == 'review' %}
            <div class="luna-finished-proof__review-{{ section.id }}" {{ block.shopify_attributes }}>
              {% if block.settings.quote != blank %}
                <p class="luna-finished-proof__review-quote-{{ section.id }}">“{{ block.settings.quote }}”</p>
              {% endif %}
              <div class="luna-finished-proof__review-meta-{{ section.id }}">
