{% liquid
  assign desktop_card_width = 30
  if section.settings.desktop_columns == 2
    assign desktop_card_width = 44
  elsif section.settings.desktop_columns == 4
    assign desktop_card_width = 24
  endif
%}

{% style %}
  .luna-finished-proof-{{ section.id }} {
    background:
      radial-gradient(circle at 10% 8%, rgba(72,205,255,.14), transparent 30%),
      radial-gradient(circle at 92% 4%, rgba(255,168,204,.20), transparent 34%),
      linear-gradient(90deg, #dfeef9 0%, #f9edf3 100%);
    padding: 56px 0 64px;
    overflow: hidden;
  }

  .luna-finished-proof-{{ section.id }} .page-width {
    max-width: 1320px;
  }

  .luna-finished-proof__header-{{ section.id }} {
    text-align: center;
    max-width: 860px;
    margin: 0 auto 34px;
  }

  .luna-finished-proof__kicker-{{ section.id }} {
    margin: 0 0 10px;
    font-size: 13px;
    line-height: 1;
    letter-spacing: .18em;
    text-transform: uppercase;
    font-weight: 950;
    color: #9d6e7d;
  }

  .luna-finished-proof__heading-{{ section.id }} {
    margin: 0 0 10px;
    font-size: clamp(30px, 4vw, 54px);
    line-height: .98;
    font-weight: 950;
    letter-spacing: -.045em;
    color: #111;
  }

  .luna-finished-proof__subheading-{{ section.id }} {
    margin: 0;
    font-size: 20px;
    line-height: 1.35;
    font-weight: 700;
    color: #5c5c5c;
  }

  .luna-finished-proof__looks-{{ section.id }} {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(280px, 82%);
    gap: 18px;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 2px 0 14px;
    margin-top: 26px;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
  }

  .luna-finished-proof__looks-{{ section.id }}::-webkit-scrollbar {
    height: 8px;
  }

  .luna-finished-proof__looks-{{ section.id }}::-webkit-scrollbar-thumb {
    background: rgba(0,0,0,.16);
    border-radius: 999px;
  }

  .luna-finished-proof__look-{{ section.id }} {
    scroll-snap-align: start;
  }

  .luna-finished-proof__look-image-wrap-{{ section.id }} {
    border-radius: 24px;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 18px 40px rgba(0,0,0,.08);
    border: 1px solid rgba(230,160,170,.22);
  }

  .luna-finished-proof__look-image-{{ section.id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .luna-finished-proof__look-caption-{{ section.id }} {
    margin: 10px 2px 0;
    font-size: 15px;
    line-height: 1.45;
    color: #6a6a6a;
    font-weight: 750;
    text-align: center;
  }

  .luna-finished-proof__reviews-{{ section.id }} {
    display: grid;
    gap: 16px;
    margin-top: 34px;
  }

  .luna-finished-proof__review-{{ section.id }} {
    background: rgba(255,255,255,.76);
    border: 1px solid rgba(232,188,199,.72);
    border-radius: 22px;
    padding: 18px 18px 16px;
    box-shadow: 0 10px 24px rgba(0,0,0,.04);
  }

  .luna-finished-proof__review-quote-{{ section.id }} {
    margin: 0 0 10px;
    font-size: 18px;
    line-height: 1.45;
    font-weight: 750;
    color: #202020;
  }

  .luna-finished-proof__review-meta-{{ section.id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 12px;
    align-items: center;
    font-size: 13px;
    line-height: 1.2;
    color: #777;
    font-weight: 850;
    text-transform: uppercase;
    letter-spacing: .08em;
  }

  .luna-finished-proof__footer-{{ section.id }} {
    text-align: center;
    margin-top: 26px;
    font-size: 15px;
    line-height: 1.5;
    color: #666;
    font-weight: 700;
  }

  @media screen and (min-width: 750px) {
    .luna-finished-proof__looks-{{ section.id }} {
      grid-auto-columns: minmax(340px, 38%);
    }

    .luna-finished-proof__reviews-{{ section.id }} {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 1100px) {
    .luna-finished-proof__looks-{{ section.id }} {
      grid-auto-columns: minmax(360px, {{ desktop_card_width }}%);
    }

    .luna-finished-proof__reviews-{{ section.id }} {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .luna-finished-proof-{{ section.id }} {
      padding: 40px 0 46px;
    }

    .luna-finished-proof__header-{{ section.id }} {
      margin-bottom: 24px;
    }

    .luna-finished-proof__subheading-{{ section.id }} {
      font-size: 16px;
    }

    .luna-finished-proof__reviews-{{ section.id }} {
      margin-top: 26px;
    }
  }
{% endstyle %}

<section class="luna-finished-proof-{{ section.id }}">
