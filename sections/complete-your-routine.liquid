<div class="complete-routine-{{ section.id }}" style="padding:24px 16px;background:#fff;">
  <p style="font-size:11px;font-weight:700;color:#2C2C2C;text-transform:uppercase;letter-spacing:0.08em;margin:0 0 16px;text-align:center;">Complete Your Routine</p>
  <div style="display:flex;gap:10px;">

    {%- comment -%} Argan Oil Straightener {%- endcomment -%}
    <div style="flex:1;border:1px solid rgba(0,0,0,0.07);border-radius:10px;overflow:hidden;text-align:center;display:flex;flex-direction:column;">
      <a href="/products/ceramic-argan-oil-infused-straightener">
        <img src="https://cdn.shopify.com/s/files/1/0609/7426/8657/files/straighhtenerandbox.png?v=1774259987"
             alt="Argan Oil Straightener"
             style="width:100%;aspect-ratio:1;object-fit:cover;display:block;">
      </a>
      <div style="padding:8px 8px 12px;display:flex;flex-direction:column;flex:1;">
        <p style="font-size:10px;font-weight:600;color:#2C2C2C;margin:0 0 2px;line-height:1.3;">Argan Oil Straightener</p>
        <p style="font-size:10px;color:#555;margin:0 0 10px;">$49.99</p>
        <form action="/cart/add" method="post" style="margin-top:auto;">
          <input type="hidden" name="id" value="42031447769329">
          <input type="hidden" name="quantity" value="1">
          <button type="submit"
                  style="width:100%;background:#E8A0A8;color:#fff;font-size:10px;font-weight:700;padding:8px 4px;border:none;border-radius:6px;cursor:pointer;text-transform:uppercase;letter-spacing:0.05em;">
            Add to Cart
          </button>
        </form>
      </div>
    </div>

    {%- comment -%} 25mm Curling Tong {%- endcomment -%}
    <div style="flex:1;border:1px solid rgba(0,0,0,0.07);border-radius:10px;overflow:hidden;text-align:center;display:flex;flex-direction:column;">
      <a href="/products/curling-tong">
        <img src="https://cdn.shopify.com/s/files/1/0609/7426/8657/files/Curler_and_box.png?v=1774262552"
             alt="25mm Curling Tong"
             style="width:100%;aspect-ratio:1;object-fit:cover;display:block;">
      </a>
      <div style="padding:8px 8px 12px;display:flex;flex-direction:column;flex:1;">
        <p style="font-size:10px;font-weight:600;color:#2C2C2C;margin:0 0 2px;line-height:1.3;">25mm Curling Tong</p>
        <p style="font-size:10px;color:#555;margin:0 0 10px;">$39.99</p>
        <form action="/cart/add" method="post" style="margin-top:auto;">
          <input type="hidden" name="id" value="42031458124017">
          <input type="hidden" name="quantity" value="1">
          <button type="submit"
                  style="width:100%;background:#E8A0A8;color:#fff;font-size:10px;font-weight:700;padding:8px 4px;border:none;border-radius:6px;cursor:pointer;text-transform:uppercase;letter-spacing:0.05em;">
            Add to Cart
          </button>
        </form>
      </div>
    </div>

  </div>
</div>

