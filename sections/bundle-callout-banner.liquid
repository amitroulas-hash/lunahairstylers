{% assign ai_gen_id = section.id | replace: '_', '' | downcase %}

{% style %}
  .ai-callout-banner-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ section.settings.background_color }};
    border-radius: {{ section.settings.border_radius }}px;
    padding: {{ section.settings.padding_vertical }}px {{ section.settings.padding_horizontal }}px;
    text-align: center;
  }
  .ai-callout-banner__content-{{ ai_gen_id }} {
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: center;
  }
  .ai-callout-banner__heading-{{ ai_gen_id }} {
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 700;
    color: {{ section.settings.heading_color }};
    margin: 0;
    line-height: 1.2;
  }
  .ai-callout-banner__subheading-{{ ai_gen_id }} {
    font-size: {{ section.settings.subheading_size }}px;
    color: {{ section.settings.subheading_color }};
    margin: 0;
    line-height: 1.4;
  }
  .ai-callout-banner__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ section.settings.button_padding_vertical }}px {{ section.settings.button_padding_horizontal }}px;
    background-color: {{ section.settings.button_background }};
    color: {{ section.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ section.settings.button_border_radius }}px;
    font-size: {{ section.settings.button_font_size }}px;
    font-weight: 600;
    transition: opacity 0.3s ease;
  }
  .ai-callout-banner__button-{{ ai_gen_id }}:hover { opacity: 0.8; }
  @media screen and (max-width: 749px) {
    .ai-callout-banner-{{ ai_gen_id }} {
      padding: {{ section.settings.padding_vertical_mobile }}px {{ section.settings.padding_horizontal_mobile }}px;
    }
    .ai-callout-banner__heading-{{ ai_gen_id }} { font-size: {{ section.settings.heading_size_mobile }}px; }
    .ai-callout-banner__subheading-{{ ai_gen_id }} { font-size: {{ section.settings.subheading_size_mobile }}px; }
    .ai-callout-banner__button-{{ ai_gen_id }} { font-size: {{ section.settings.button_font_size_mobile }}px; }
  }
{% endstyle %}

<div class="ai-callout-banner-{{ ai_gen_id }}">
  <div class="ai-callout-banner__content-{{ ai_gen_id }}">
    {% if section.settings.heading != blank %}
      <h2 class="ai-callout-banner__heading-{{ ai_gen_id }}">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.subheading != blank %}
      <p class="ai-callout-banner__subheading-{{ ai_gen_id }}">{{ section.settings.subheading }}</p>
    {% endif %}
    {% if section.settings.button_text != blank and section.settings.button_link != blank %}
      <a href="{{ section.settings.button_link }}" class="ai-callout-banner__button-{{ ai_gen_id }}">{{ section.settings.button_text }}</a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Bundle Callout Banner",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bundle & Save 30%" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Add any second Luna product and get 30% off automatically at checkout." },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "SHOP ALL PRODUCTS" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#E6A0AA" },
    { "type": "range", "id": "border_radius", "min": 0, "max": 30, "step": 2, "unit": "px", "label": "Border radius", "default": 12 },
    { "type": "range", "id": "padding_vertical", "min": 10, "max": 60, "step": 5, "unit": "px", "label": "Vertical padding", "default": 25 },
    { "type": "range", "id": "padding_horizontal", "min": 10, "max": 60, "step": 5, "unit": "px", "label": "Horizontal padding", "default": 20 },
    { "type": "range", "id": "padding_vertical_mobile", "min": 10, "max": 50, "step": 5, "unit": "px", "label": "Vertical padding mobile", "default": 20 },
    { "type": "range", "id": "padding_horizontal_mobile", "min": 10, "max": 40, "step": 5, "unit": "px", "label": "Horizontal padding mobile", "default": 15 },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#000000" },
    { "type": "range", "id": "heading_size", "min": 16, "max": 40, "step": 2, "unit": "px", "label": "Heading size", "default": 24 },
    { "type": "range", "id": "heading_size_mobile", "min": 14, "max": 30, "step": 2, "unit": "px", "label": "Heading size mobile", "default": 20 },
    { "type": "color", "id": "subheading_color", "label": "Subheading color", "default": "#000000" },
    { "type": "range", "id": "subheading_size", "min": 12, "max": 24, "step": 1, "unit": "px", "label": "Subheading size", "default": 15 },
    { "type": "range", "id": "subheading_size_mobile", "min": 11, "max": 18, "step": 1, "unit": "px", "label": "Subheading size mobile", "default": 13 },
    { "type": "color", "id": "button_background", "label": "Button background", "default": "#ffffff" },
    { "type": "color", "id": "button_text_color", "label": "Button text color", "default": "#000000" },
    { "type": "range", "id": "button_font_size", "min": 11, "max": 20, "step": 1, "unit": "px", "label": "Button font size", "default": 13 },
    { "type": "range", "id": "button_font_size_mobile", "min": 10, "max": 18, "step": 1, "unit": "px", "label": "Button font size mobile", "default": 12 },
    { "type": "range", "id": "button_padding_vertical", "min": 6, "max": 20, "step": 2, "unit": "px", "label": "Button vertical padding", "default": 10 },
    { "type": "range", "id": "button_padding_horizontal", "min": 12, "max": 40, "step": 2, "unit": "px", "label": "Button horizontal padding", "default": 20 },
    { "type": "range", "id": "button_border_radius", "min": 0, "max": 30, "step": 2, "unit": "px", "label": "Button border radius", "default": 6 }
  ],
  "presets": [{ "name": "Bundle Callout Banner" }]
}
{% endschema %}
