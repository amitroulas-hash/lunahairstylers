{% comment %} Luna Products — homepage full range showcase, no tabs {% endcomment %}

<section class="luna-products-v2-{{ section.id }}">
  <div class="lpv2-inner-{{ section.id }}">

    <p class="lpv2-kicker-{{ section.id }}">Find your styler</p>
    <h2 class="lpv2-heading-{{ section.id }}">Salon-worthy styling. Smarter prices.</h2>
    <p class="lpv2-subheading-{{ section.id }}">
      Smooth it, curl it, dry it or travel light — find the Luna styler made for your routine.
    </p>

       <div class="lpv2-carousel-wrap-{{ section.id }}">
      <button class="lpv2-arrow-{{ section.id }} lpv2-arrow--prev-{{ section.id }}" type="button" data-direction="prev" aria-label="Previous Luna products">
        ‹
      </button>

      <div class="lpv2-products-{{ section.id }}">
        {% for i in (1..3) %}
          {% assign setting_id = 'hero_product_' | append: i %}
          {% assign p = section.settings[setting_id] %}
          {% if p != blank and p.handle != 'travel-dryer' %}
            {% render 'luna-product-home-card', product: p, section_id: section.id, dryer_handle: section.settings.dryer_handle %}
          {% endif %}
        {% endfor %}

        {% for i in (1..2) %}
          {% assign setting_id = 'travel_product_' | append: i %}
          {% assign p = section.settings[setting_id] %}
          {% if p != blank and p.handle != 'travel-dryer' %}
            {% render 'luna-product-home-card', product: p, section_id: section.id, dryer_handle: section.settings.dryer_handle %}
          {% endif %}
        {% endfor %}
      </div>

      <button class="lpv2-arrow-{{ section.id }} lpv2-arrow--next-{{ section.id }}" type="button" data-direction="next" aria-label="Next Luna products">
        ›
      </button>
    </div>

  </div>
</section>

<style>
.luna-products-v2-{{ section.id }} {
  position: relative;
  background:
    radial-gradient(circle at 12% 18%, rgba(88, 207, 255, .34) 0, rgba(88, 207, 255, 0) 34%),
    radial-gradient(circle at 86% 12%, rgba(255, 176, 210, .52) 0, rgba(255, 176, 210, 0) 34%),
    linear-gradient(135deg, #f7fbff 0%, #fff7fb 52%, #fdf1f8 100%);
  padding: 48px 16px 56px;
  overflow: hidden;
}
.luna-products-v2-{{ section.id }}::before,
.luna-products-v2-{{ section.id }}::after {
  content: "";
  position: absolute;
  z-index: 0;
  border-radius: 999px;
  pointer-events: none;
}

.luna-products-v2-{{ section.id }}::before {
  width: 420px;
  height: 420px;
  left: -160px;
  top: 80px;
  background: rgba(102, 212, 255, .16);
  filter: blur(4px);
}

.luna-products-v2-{{ section.id }}::after {
  width: 520px;
  height: 520px;
  right: -220px;
  bottom: -170px;
  background: rgba(255, 159, 194, .18);
  filter: blur(6px);
}

.lpv2-inner-{{ section.id }} {
  position: relative;
  z-index: 1;
  max-width: 1520px;
  margin: 0 auto;
}

.lpv2-kicker-{{ section.id }} {
  margin: 0 0 8px;
  text-align: center;
  font-size: 12px;
  font-weight: 900;
  letter-spacing: .16em;
  text-transform: uppercase;
  color: #a7657b;
}

.lpv2-heading-{{ section.id }} {
  margin: 0 0 10px;
  text-align: center;
  font-size: 34px;
  line-height: .98;
  font-weight: 950;
  letter-spacing: -.035em;
  color: #111;
}

.lpv2-subheading-{{ section.id }} {
  margin: 0 auto 24px;
  max-width: 720px;
  text-align: center;
  font-size: 15px;
  line-height: 1.45;
  color: #555;
}

.lpv2-carousel-wrap-{{ section.id }} {
  position: relative;
}

.lpv2-products-{{ section.id }} {
  display: flex;
  gap: 14px;
  overflow-x: auto;
  overflow-y: hidden;
  scroll-snap-type: x mandatory;
  scroll-padding-left: 2px;
  scroll-behavior: smooth;
  padding: 2px 2px 14px;
  -webkit-overflow-scrolling: touch;
}

.lpv2-products-{{ section.id }}::-webkit-scrollbar {
  height: 6px;
}

.lpv2-products-{{ section.id }}::-webkit-scrollbar-track {
  background: #FDF4F6;
  border-radius: 999px;
}

.lpv2-products-{{ section.id }}::-webkit-scrollbar-thumb {
  background: rgba(230,160,170,.85);
  border-radius: 999px;
}

.lpv2-arrow-{{ section.id }} {
  display: none;
  position: absolute;
  top: 50%;
  z-index: 8;
  width: 44px;
  height: 44px;
  border-radius: 999px;
  border: 1px solid rgba(230,160,170,.45);
  background: #fff;
  color: #111;
  box-shadow: 0 10px 24px rgba(0,0,0,.12);
  font-size: 34px;
  line-height: 1;
  font-weight: 700;
  cursor: pointer;
  align-items: center;
  justify-content: center;
  transform: translateY(-50%);
}

.lpv2-arrow--prev-{{ section.id }} {
  left: 12px;
}

.lpv2-arrow--next-{{ section.id }} {
  right: 12px;
}
.lpv2-arrow-{{ section.id }}.is-disabled {
  opacity: 0;
  pointer-events: none;
}

.lpv2-card-{{ section.id }} {
  border: 1px solid rgba(230,160,170,.26);
  border-radius: 24px;
  background: rgba(255,255,255,.84);
  overflow: hidden;
  box-shadow: 0 18px 42px rgba(230,160,170,.16);
  display: flex;
  flex-direction: column;
  backdrop-filter: blur(10px);
  transition: transform .28s ease, box-shadow .28s ease;
}

@media screen and (min-width: 990px) {
  .lpv2-card-{{ section.id }}:hover {
    transform: translateY(-6px);
    box-shadow: 0 24px 54px rgba(230,160,170,.23);
  }
}

.lpv2-media-{{ section.id }} {
  position: relative;
  display: block;
  aspect-ratio: 1 / 1;
  background:
    radial-gradient(circle at 50% 44%, rgba(255,255,255,.95) 0%, rgba(255,255,255,.78) 42%, rgba(255,232,241,.72) 100%);
  overflow: hidden;
  text-decoration: none;
}

.lpv2-media-{{ section.id }}::before {
  content: "";
  position: absolute;
  inset: 14px;
  border-radius: 22px;
  background:
    radial-gradient(circle at 24% 24%, rgba(88,207,255,.20), transparent 30%),
    radial-gradient(circle at 78% 18%, rgba(255,159,194,.24), transparent 32%);
  z-index: 0;
  pointer-events: none;
}

@media screen and (max-width: 749px) {
  .lpv2-media-{{ section.id }} {
    aspect-ratio: 4 / 3;
  }

  .lpv2-products-{{ section.id }} .lpv2-card-{{ section.id }} {
    flex: 0 0 84%;
  }
}

.lpv2-rotator-{{ section.id }} {
  position: absolute;
  inset: 0;
  z-index: 1;
  overflow: hidden;
}

.lpv2-img-{{ section.id }} {
  position: absolute;
  inset: 0;
  z-index: 1;
  width: 100%;
  height: 100%;
  object-fit: contain;
  padding: 16px;
  opacity: 0;
  transition: opacity .28s ease, transform .28s ease;
}

.lpv2-img-{{ section.id }}.is-1 {
  opacity: 1;
  animation: lunaProductFloat{{ section.id }} 4.8s ease-in-out infinite;
}

.lpv2-img-{{ section.id }}.is-2 {
  opacity: 0;
}

.lpv2-img-{{ section.id }}.is-3 {
  display: none;
}

@keyframes lunaProductFloat{{ section.id }} {
  0%, 100% {
    transform: translateY(0) scale(1);
  }
  50% {
    transform: translateY(-7px) scale(1.015);
  }
}

@media screen and (min-width: 990px) {
  .has-hover-image-{{ section.id }}:hover .lpv2-img-{{ section.id }}.is-1 {
    opacity: 0;
  }

  .has-hover-image-{{ section.id }}:hover .lpv2-img-{{ section.id }}.is-2 {
    opacity: 1;
    transform: translateY(-4px) scale(1.02);
  }
}

.lpv2-badge-{{ section.id }} {
  position: absolute;
  z-index: 3;
  left: 10px;
  max-width: calc(100% - 20px);
  padding: 7px 10px;
  border-radius: 999px;
  font-size: 10px;
  line-height: 1.1;
  font-weight: 900;
  letter-spacing: .045em;
  text-transform: uppercase;
  white-space: normal;
}

.lpv2-badge-{{ section.id }} {
  top: 10px;
  background: #FDF4F6;
  border: 1px solid rgba(230,160,170,.5);
  color: #111;
}


.lpv2-info-{{ section.id }} {
  padding: 12px;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.lpv2-stars-{{ section.id }} {
  min-height: 18px;
  margin-bottom: 6px;
}

.lpv2-stars-{{ section.id }} .jdgm-star {
  color: #E6A0AA !important;
}

.lpv2-stars-{{ section.id }} .jdgm-prev-badge__text,
.lpv2-stars-{{ section.id }} .jdgm-preview-badge__text {
  font-size: 12px !important;
  color: #666 !important;
}

.lpv2-title-{{ section.id }} {
  margin: 0 0 6px;
  min-height: 34px;
  font-size: 16px;
  line-height: 1.12;
  font-weight: 900;
  color: #111;
}

.lpv2-title-{{ section.id }} a {
  color: inherit;
  text-decoration: none;
}
.lpv2-copy-{{ section.id }} {
  margin: 0 0 12px;
  color: #555;
  font-size: 13px;
  line-height: 1.35;
  min-height: 36px;
}

.lpv2-price-{{ section.id }} {
  margin: 0 0 12px;
}

.lpv2-buttons-{{ section.id }} {
  display: grid;
  grid-template-columns: 1fr;
  gap: 8px;
  margin-top: auto;
}

.lpv2-atc-{{ section.id }},
.lpv2-view-{{ section.id }} {
  width: 100%;
  min-height: 44px;
  border-radius: 11px;
  font-size: 13px;
  font-weight: 900;
  text-align: center;
  text-decoration: none;
  cursor: pointer;
}

.lpv2-atc-{{ section.id }} {
  background: #111;
  color: #fff;
  border: none;
}

.lpv2-view-{{ section.id }} {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FDF4F6;
  color: #111;
  border: 1px solid rgba(230,160,170,.45);
}

@media screen and (min-width: 750px) {
  .lpv2-products-{{ section.id }} .lpv2-card-{{ section.id }} {
    flex-basis: 46%;
  }
}

@media screen and (min-width: 990px) {
  .luna-products-v2-{{ section.id }} {
    padding: 54px 40px 64px;
  }

  .lpv2-heading-{{ section.id }} {
    font-size: clamp(34px, 3.2vw, 40px);
    max-width: 980px;
    margin-left: auto;
    margin-right: auto;
  }

  .lpv2-subheading-{{ section.id }} {
    max-width: 820px;
  }

  .lpv2-products-{{ section.id }} {
    gap: 18px;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 2px 56px 14px;
    scrollbar-width: none;
  }

  .lpv2-products-{{ section.id }}::-webkit-scrollbar {
    display: none;
  }

  .lpv2-products-{{ section.id }} .lpv2-card-{{ section.id }} {
    flex: 0 0 calc((100% - 18px) / 2);
    min-width: 320px;
    max-width: 460px;
    scroll-snap-align: start;
  }

  .lpv2-arrow-{{ section.id }} {
    display: flex;
  }

  .lpv2-img-{{ section.id }} {
    padding: 20px;
  }

  .lpv2-buttons-{{ section.id }} {
    grid-template-columns: 1fr;
  }
}

@media screen and (min-width: 1200px) {
  .lpv2-products-{{ section.id }} .lpv2-card-{{ section.id }} {
    flex: 0 0 calc((100% - 36px) / 3);
    min-width: 300px;
    max-width: 440px;
  }

  .lpv2-buttons-{{ section.id }} {
    grid-template-columns: 1fr 1fr;
  }
}

@media screen and (min-width: 1800px) {
  .lpv2-products-{{ section.id }} {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 24px;
    overflow: visible;
    padding: 0;
  }

  .lpv2-products-{{ section.id }} .lpv2-card-{{ section.id }} {
    flex: initial;
    min-width: 0;
    max-width: none;
    scroll-snap-align: none;
  }

  .lpv2-arrow-{{ section.id }} {
    display: none;
  }
}
@media (prefers-reduced-motion: reduce) {
  .lpv2-img-{{ section.id }}.is-1 {
    animation: none !important;
  }

  .lpv2-card-{{ section.id }} {
    transition: none !important;
  }
}
</style>

<script>
(function() {
  var section = document.querySelector('.luna-products-v2-{{ section.id }}');
  if (!section) return;

      var scroller = section.querySelector('.lpv2-products-{{ section.id }}');
  var prevArrow = section.querySelector('.lpv2-arrow--prev-{{ section.id }}');
  var nextArrow = section.querySelector('.lpv2-arrow--next-{{ section.id }}');

  function updateArrowState() {
    if (!scroller || !prevArrow || !nextArrow) return;

    var maxScroll = scroller.scrollWidth - scroller.clientWidth;
    var currentScroll = scroller.scrollLeft;
    var tolerance = 6;

    if (maxScroll <= tolerance) {
      prevArrow.classList.add('is-disabled');
      nextArrow.classList.add('is-disabled');
      return;
    }

    if (currentScroll <= tolerance) {
      prevArrow.classList.add('is-disabled');
    } else {
      prevArrow.classList.remove('is-disabled');
    }

    if (currentScroll >= maxScroll - tolerance) {
      nextArrow.classList.add('is-disabled');
    } else {
      nextArrow.classList.remove('is-disabled');
    }
  }

  [prevArrow, nextArrow].forEach(function(arrow) {
    if (!arrow) return;

    arrow.addEventListener('click', function() {
      if (!scroller) return;

      var firstCard = scroller.querySelector('.lpv2-card-{{ section.id }}');
      var cardWidth = firstCard ? firstCard.offsetWidth : scroller.clientWidth;
      var gap = 18;
      var direction = arrow.dataset.direction === 'prev' ? -1 : 1;

      scroller.scrollBy({
        left: direction * ((cardWidth + gap) * 2),
        behavior: 'smooth'
      });

      window.setTimeout(updateArrowState, 360);
    });
  });

  if (scroller) {
    scroller.addEventListener('scroll', updateArrowState, { passive: true });
  }

  window.addEventListener('resize', updateArrowState);
  updateArrowState();
  section.addEventListener('click', async function(event) {
    var button = event.target.closest('.lpv2-atc-{{ section.id }}');
    if (!button) return;

    event.preventDefault();

    var variantId = parseInt(button.dataset.variantId, 10);
    var handle = button.dataset.productHandle;

    if (!variantId) return;

    var itemsToAdd = [{ id: variantId, quantity: 1 }];

    button.disabled = true;
    button.textContent = 'Adding...';

    try {
      await fetch(window.Shopify.routes.root + 'cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ items: itemsToAdd })
      });

      window.location.href = window.Shopify.routes.root + 'cart';
    } catch (error) {
      console.error('Luna homepage add failed:', error);
      button.disabled = false;
      button.textContent = 'Add to Cart';
      alert('Sorry, something went wrong. Please try again.');
    }
  });
})();
</script>

{% schema %}
{
  "name": "Luna Products",
  "settings": [
    {
      "type": "product",
      "id": "hero_product_1",
      "label": "Product 1 — Hair Dryer"
    },
    {
      "type": "product",
      "id": "hero_product_2",
      "label": "Product 2 — Straightener"
    },
    {
      "type": "product",
      "id": "hero_product_3",
      "label": "Product 3 — Curling Tong"
    },
    {
      "type": "product",
      "id": "travel_product_1",
      "label": "Product 4 — Mini Straightener"
    },
    {
      "type": "product",
      "id": "travel_product_2",
      "label": "Product 5 — Travel Dryer"
    },
    {
      "type": "text",
      "id": "dryer_handle",
      "label": "Dryer product handle",
      "default": "dryer"
    }
  ],
  "presets": [
    {
      "name": "Luna Products"
    }
  ]
}
{% endschema %}