    { "type": "text", "id": "video_caption_2", "label": "Video 2 caption", "default": "Smooth finish" },
    { "type": "video", "id": "video_3", "label": "Video 3" },
    { "type": "text", "id": "video_caption_3", "label": "Video 3 caption", "default": "Luxe Kit routine" },
