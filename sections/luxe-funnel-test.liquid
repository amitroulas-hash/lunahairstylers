    { "type": "text", "id": "review_1_name", "label": "Review 1 name", "default": "FERN" },
    { "type": "text", "id": "review_2_title", "label": "Review 2 title", "default": "Value for money" },
    { "type": "textarea", "id": "review_2_text", "label": "Review 2 text", "default": "Excellent value, most powerful hairdryer for its price range." },
    { "type": "text", "id": "review_2_name", "label": "Review 2 name", "default": "ROSC" },
    { "type": "text", "id": "review_3_title", "label": "Review 3 title", "default": "Impressed!" },
    { "type": "textarea", "id": "review_3_text", "label": "Review 3 text", "default": "Lightweight, powerful and easy to use." },
