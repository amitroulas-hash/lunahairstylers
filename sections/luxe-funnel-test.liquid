{% assign dryer_product = section.settings.dryer_product %}
{% assign luxe_product = section.settings.luxe_product %}
{% assign dryer_variant = dryer_product.selected_or_first_available_variant %}
{% assign luxe_variant = luxe_product.selected_or_first_available_variant %}

<section class="ldf-{{ section.id }}">

  <div class="ldf-hero">
    <div class="ldf-hero__media">
      {% if section.settings.hero_image != blank %}
        <img src="{{ section.settings.hero_image | image_url: width: 1800 }}" alt="{{ section.settings.hero_heading | escape }}" loading="eager">
      {% endif %}
    </div>

    <div class="ldf-hero__copy">
      <p class="ldf-kicker">{{ section.settings.hero_kicker }}</p>
      <h1>{{ section.settings.hero_heading }}</h1>
      <p>{{ section.settings.hero_text }}</p>

      {% if dryer_product != blank %}
        <div class="ldf-price">
          <strong>{{ dryer_variant.price | money }}</strong>
          {% if dryer_variant.compare_at_price > dryer_variant.price %}
            <s>{{ dryer_variant.compare_at_price | money }}</s>
            <span>Save {{ dryer_variant.compare_at_price | minus: dryer_variant.price | money }}</span>
          {% endif %}
        </div>
      {% endif %}

      <button class="ldf-atc" data-dryer-id="{{ dryer_variant.id }}" data-luxe-id="{{ luxe_variant.id }}">
        {{ section.settings.hero_button }}
      </button>

      <small>{{ section.settings.trust_line }}</small>
    </div>
  </div>

  <div class="ldf-strip">
    <span>2200W Ionic Power</span>
    <span>FREE Luxe Kit</span>
    <span>12-Month Warranty</span>
  </div>

  <div class="ldf-deal">
    <div class="ldf-deal__card">
      {% if section.settings.dryer_image != blank %}
        <img src="{{ section.settings.dryer_image | image_url: width: 900 }}" loading="lazy">
      {% endif %}
      <div>
        <p class="ldf-kicker">You buy</p>
        <h2>Luna Ionic Hair Dryer</h2>
        <p>Fast drying, smooth finish and big-hair energy at an everyday price.</p>
      </div>
    </div>

    <div class="ldf-plus">+</div>

    <div class="ldf-deal__card ldf-deal__card--gift">
      {% if section.settings.kit_image != blank %}
        <img src="{{ section.settings.kit_image | image_url: width: 900 }}" loading="lazy">
      {% endif %}
      <div>
        <p class="ldf-kicker">You get free</p>
        <h2>Luxe Hair Kit</h2>
        <p>Detangling brush, wide-tooth comb, claw clip and scalp massager.</p>
      </div>
    </div>
  </div>

  <div class="ldf-why">
    <p class="ldf-kicker">{{ section.settings.why_kicker }}</p>
    <h2>{{ section.settings.why_heading }}</h2>

    <div class="ldf-why__grid">
      <div><strong>Fast</strong><span>2200W drying power for everyday routines.</span></div>
      <div><strong>Smooth</strong><span>Ionic technology helps reduce frizz.</span></div>
      <div><strong>Easy</strong><span>Brush, section and finish with the free kit.</span></div>
      <div><strong>Smart</strong><span>Performance without the inflated price tag.</span></div>
    </div>
  </div>

  <div class="ldf-routine">
    <div>
      <p class="ldf-kicker">{{ section.settings.routine_kicker }}</p>
      <h2>{{ section.settings.routine_heading }}</h2>
    </div>

    <div class="ldf-routine__steps">
      <div><b>01</b><strong>Dry</strong><span>Use the Ionic Dryer to dry and prep.</span></div>
      <div><b>02</b><strong>Brush</strong><span>Detangle and smooth with your kit.</span></div>
      <div><b>03</b><strong>Section</strong><span>Clip, comb and control your styling.</span></div>
      <div><b>04</b><strong>Finish</strong><span>Create a polished everyday look.</span></div>
    </div>
  </div>

  <div class="ldf-videos">
    <p class="ldf-kicker">{{ section.settings.video_kicker }}</p>
    <h2>{{ section.settings.video_heading }}</h2>

    <div class="ldf-video-row">
      {% for i in (1..4) %}
        {% assign video_key = 'video_' | append: i %}
        {% assign caption_key = 'video_caption_' | append: i %}
        {% assign video = section.settings[video_key] %}
        {% assign caption = section.settings[caption_key] %}

        <div class="ldf-video">
          {% if video != blank %}
            {{ video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true }}
          {% endif %}
          <span>{{ caption }}</span>
        </div>
      {% endfor %}
    </div>
  </div>

  <div class="ldf-reviews">
    <p class="ldf-kicker">{{ section.settings.review_kicker }}</p>
    <h2>{{ section.settings.review_heading }}</h2>

    <div class="ldf-review-row">
      <div><span>★★★★★</span><strong>{{ section.settings.review_1_title }}</strong><p>{{ section.settings.review_1_text }}</p><small>{{ section.settings.review_1_name }}</small></div>
      <div><span>★★★★★</span><strong>{{ section.settings.review_2_title }}</strong><p>{{ section.settings.review_2_text }}</p><small>{{ section.settings.review_2_name }}</small></div>
      <div><span>★★★★★</span><strong>{{ section.settings.review_3_title }}</strong><p>{{ section.settings.review_3_text }}</p><small>{{ section.settings.review_3_name }}</small></div>
    </div>
  </div>

  <div class="ldf-final">
    {% if section.settings.final_image != blank %}
      <img src="{{ section.settings.final_image | image_url: width: 1400 }}" loading="lazy">
    {% endif %}
    <h2>{{ section.settings.final_heading }}</h2>
    <p>{{ section.settings.final_text }}</p>
    <button class="ldf-atc" data-dryer-id="{{ dryer_variant.id }}" data-luxe-id="{{ luxe_variant.id }}">
      {{ section.settings.final_button }}
    </button>
  </div>

  <div class="ldf-sticky">
    <div>
      <strong>Dryer + FREE Luxe Kit</strong>
      {% if dryer_product != blank %}
        <span>{{ dryer_variant.price | money }} · Limited offer</span>
      {% endif %}
    </div>
    <button class="ldf-atc" data-dryer-id="{{ dryer_variant.id }}" data-luxe-id="{{ luxe_variant.id }}">Add to Cart</button>
  </div>

</section>

<style>
.ldf-{{ section.id }}{background:#fff;color:#111;overflow:hidden}
.ldf-{{ section.id }} h1,.ldf-{{ section.id }} h2,.ldf-{{ section.id }} p{margin:0}
.ldf-kicker{font-size:12px;font-weight:750;letter-spacing:.14em;text-transform:uppercase;color:#9d6b79;margin-bottom:10px!important}

.ldf-hero{display:grid;grid-template-columns:1.08fr .92fr;min-height:680px;background:#fdf4f6}
.ldf-hero__media img{width:100%;height:100%;object-fit:cover;display:block}
.ldf-hero__copy{display:flex;flex-direction:column;justify-content:center;padding:56px;max-width:620px}
.ldf-hero__copy h1{font-size:58px;line-height:1;font-weight:700;margin-bottom:16px}
.ldf-hero__copy p:not(.ldf-kicker){font-size:20px;line-height:1.45;color:#444;margin-bottom:18px}
.ldf-price{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin:4px 0 22px}
.ldf-price strong{font-size:36px}.ldf-price s{font-size:22px;color:#999}.ldf-price span{font-size:15px;font-weight:700;color:#b93a3a}
.ldf-atc{border:0;border-radius:12px;background:#d80000;color:#fff;padding:16px 24px;font-size:16px;font-weight:700;cursor:pointer;width:fit-content}
.ldf-hero__copy small{display:block;margin-top:14px;color:#666;font-size:13px}

.ldf-strip{display:grid;grid-template-columns:repeat(3,1fr);text-align:center;background:#111;color:#fff}
.ldf-strip span{padding:16px 10px;font-size:13px;font-weight:750;letter-spacing:.08em;text-transform:uppercase}

.ldf-deal{max-width:1180px;margin:0 auto;padding:42px 20px;display:grid;grid-template-columns:1fr auto 1fr;gap:18px;align-items:stretch}
.ldf-deal__card{border:1px solid rgba(230,160,170,.35);border-radius:24px;background:#fff;overflow:hidden;box-shadow:0 14px 34px rgba(230,160,170,.12)}
.ldf-deal__card img{width:100%;aspect-ratio:1/1;object-fit:contain;background:#fdf4f6;display:block}
.ldf-deal__card div{padding:20px}.ldf-deal__card h2{font-size:30px;line-height:1.05;font-weight:700;margin-bottom:8px}.ldf-deal__card p:not(.ldf-kicker){font-size:15px;line-height:1.45;color:#555}
.ldf-deal__card--gift{border-color:#e6a0aa}
.ldf-plus{align-self:center;width:48px;height:48px;border-radius:999px;background:#111;color:#fff;display:grid;place-items:center;font-size:30px;font-weight:700}

.ldf-why,.ldf-videos,.ldf-reviews,.ldf-routine{max-width:1180px;margin:0 auto;padding:62px 20px;text-align:center}
.ldf-why h2,.ldf-videos h2,.ldf-reviews h2,.ldf-routine h2,.ldf-final h2{font-size:42px;line-height:1.05;font-weight:700;margin-bottom:24px}
.ldf-why__grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.ldf-why__grid div{background:#fdf4f6;border:1px solid rgba(230,160,170,.35);border-radius:18px;padding:22px;text-align:left}
.ldf-why__grid strong{display:block;font-size:22px;margin-bottom:8px}.ldf-why__grid span{font-size:14px;line-height:1.45;color:#555}

.ldf-routine{max-width:none;background:#f7f7f7}
.ldf-routine>div:first-child{max-width:800px;margin:0 auto}
.ldf-routine__steps{max-width:1180px;margin:0 auto;display:grid;grid-template-columns:repeat(4,1fr);gap:14px;text-align:left}
.ldf-routine__steps div{background:#fff;border-radius:18px;padding:22px;border:1px solid #eee}
.ldf-routine__steps b{font-size:30px;color:#e6a0aa}.ldf-routine__steps strong{display:block;font-size:22px;margin:8px 0}.ldf-routine__steps span{font-size:14px;color:#555;line-height:1.45}

.ldf-video-row{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.ldf-video{position:relative;aspect-ratio:9/16;border-radius:22px;overflow:hidden;background:#f4f4f4}
.ldf-video video{width:100%;height:100%;object-fit:cover;display:block}
.ldf-video span{position:absolute;left:10px;right:10px;bottom:10px;background:rgba(255,255,255,.9);border-radius:999px;padding:8px 10px;font-size:12px;font-weight:700}

.ldf-review-row{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;text-align:left}
.ldf-review-row div{border:1px solid rgba(230,160,170,.28);border-radius:22px;background:#fff;padding:24px}
.ldf-review-row span{color:#e6a0aa;font-size:18px}.ldf-review-row strong{display:block;font-size:22px;margin:12px 0 8px}.ldf-review-row p{font-size:15px;color:#555;line-height:1.5;margin-bottom:16px}.ldf-review-row small{font-weight:700;color:#9d6b79;letter-spacing:.12em}

.ldf-final{max-width:980px;margin:0 auto;padding:62px 20px 110px;text-align:center}
.ldf-final img{width:100%;max-width:760px;border-radius:26px;margin:0 auto 24px;display:block}
.ldf-final p{font-size:18px;line-height:1.45;color:#555;margin-bottom:22px}

.ldf-sticky{position:fixed;left:12px;right:12px;bottom:12px;z-index:60;background:#111;color:#fff;border-radius:16px;padding:12px;display:none;align-items:center;justify-content:space-between;gap:12px;box-shadow:0 14px 34px rgba(0,0,0,.28)}
.ldf-sticky strong,.ldf-sticky span{display:block}.ldf-sticky span{font-size:12px;color:#ddd}.ldf-sticky .ldf-atc{font-size:13px;padding:12px 16px;white-space:nowrap}

@media(max-width:749px){
.ldf-hero{display:flex;flex-direction:column;min-height:auto}
.ldf-hero__media{height:430px}.ldf-hero__media img{object-fit:cover}
.ldf-hero__copy{padding:24px 18px 30px;text-align:center;align-items:center}
.ldf-hero__copy h1{font-size:38px}.ldf-hero__copy p:not(.ldf-kicker){font-size:16px}
.ldf-strip{grid-template-columns:1fr}.ldf-strip span{padding:10px}
.ldf-deal{display:block;padding:28px 16px}.ldf-deal__card{margin-bottom:16px}.ldf-plus{margin:0 auto 16px}
.ldf-why,.ldf-videos,.ldf-reviews,.ldf-routine{padding:46px 18px}.ldf-why h2,.ldf-videos h2,.ldf-reviews h2,.ldf-routine h2,.ldf-final h2{font-size:32px}
.ldf-why__grid,.ldf-routine__steps,.ldf-review-row{grid-template-columns:1fr}
.ldf-video-row{display:flex;overflow-x:auto;gap:14px;scroll-snap-type:x mandatory;padding-bottom:8px}
.ldf-video{flex:0 0 74%;scroll-snap-align:start}
.ldf-sticky{display:flex}
}
</style>

<script>
(function(){
  var section=document.querySelector('.ldf-{{ section.id }}');
  if(!section)return;

  section.addEventListener('click',async function(e){
    var btn=e.target.closest('.ldf-atc');
    if(!btn)return;

    var dryerId=parseInt(btn.dataset.dryerId,10);
    var luxeId=parseInt(btn.dataset.luxeId,10);
    if(!dryerId)return;

    btn.disabled=true;
    var old=btn.textContent;
    btn.textContent='Adding...';

    var items=[{id:dryerId,quantity:1}];
    if(luxeId)items.push({id:luxeId,quantity:1});

    try{
      await fetch(window.Shopify.routes.root+'cart/add.js',{
        method:'POST',
        headers:{'Content-Type':'application/json','Accept':'application/json'},
        body:JSON.stringify({items:items})
      });
      window.location.href=window.Shopify.routes.root+'cart';
    }catch(err){
      btn.disabled=false;
      btn.textContent=old;
      alert('Sorry, something went wrong. Please try again.');
    }
  });
})();
</script>

{% schema %}
{
  "name": "Luxe Funnel TEST",
  "settings": [
    { "type": "product", "id": "dryer_product", "label": "Dryer product" },
    { "type": "product", "id": "luxe_product", "label": "Luxe Kit product" },

    { "type": "image_picker", "id": "hero_image", "label": "Hero image" },
