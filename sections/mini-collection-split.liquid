<section class="mcs-{{ section.id }}">
  <div class="mcs-inner-{{ section.id }}">
    <div class="mcs-copy-{{ section.id }}">
      <p class="mcs-kicker-{{ section.id }}">{{ section.settings.kicker }}</p>
      <h2>{{ section.settings.heading }}</h2>
      <p class="mcs-sub">{{ section.settings.subheading }}</p>

      <div class="mcs-badges-{{ section.id }}">
        <span>Compact & practical</span>
        <span>Travel friendly</span>
        <span>Under $25</span>
      </div>

      <div class="mcs-card-{{ section.id }}">
        <p>{{ section.settings.body_1 }}</p>
        <p>{{ section.settings.body_2 }}</p>
      </div>

      <div class="mcs-proof-{{ section.id }}">
        <div><strong>2</strong><span>Mini styling tools</span></div>
<div><strong>From $13.69</strong><span>Accessible everyday price</span></div>
        <div><strong>Easy</strong><span>Pack, style, go</span></div>
      </div>
    </div>

    <div class="mcs-products-{{ section.id }}">
      {% for block in section.blocks %}
        {% assign featured_product = block.settings.product %}
        {% if featured_product != blank %}
          {% assign variant = featured_product.selected_or_first_available_variant %}
          {% assign image_1 = featured_product.featured_image %}
          {% assign image_2 = featured_product.images[1] %}
          {% assign image_3 = featured_product.images[2] %}

          <article class="mcs-product-{{ section.id }}" {{ block.shopify_attributes }}>
            <a href="{{ featured_product.url }}" class="mcs-media-{{ section.id }}">
              <span class="mcs-bundle-{{ section.id }}">{{ settings.luna_spend_offer_title }}</span>

              <div class="mcs-rotator-{{ section.id }}">
                {% if image_1 %}
                  <img class="mcs-img-{{ section.id }} is-1" src="{{ image_1 | image_url: width: 900 }}" alt="{{ featured_product.title | escape }}">
                {% endif %}
                {% if image_2 %}
                  <img class="mcs-img-{{ section.id }} is-2" src="{{ image_2 | image_url: width: 900 }}" alt="{{ featured_product.title | escape }}">
                {% endif %}
                {% if image_3 %}
                  <img class="mcs-img-{{ section.id }} is-3" src="{{ image_3 | image_url: width: 900 }}" alt="{{ featured_product.title | escape }}">
                {% endif %}
              </div>
            </a>

            <div class="mcs-product-info-{{ section.id }}">
              <div class="mcs-stars-{{ section.id }}">
                <div class="jdgm-widget jdgm-preview-badge" data-id="{{ featured_product.id }}">
                  {{ featured_product.metafields.judgeme.badge }}
                </div>
              </div>

              <h3>{{ featured_product.title }}</h3>
{% assign price_variant = featured_product.selected_or_first_available_variant %}

<div class="luna-price">
  {% if price_variant.compare_at_price > price_variant.price %}
    <div class="luna-price__sale-row">
      <span class="luna-price__sale">{{ price_variant.price | money }}</span>
      <s class="luna-price__compare">{{ price_variant.compare_at_price | money }}</s>
    </div>
    <div class="luna-price__save">
      Save {{ price_variant.compare_at_price | minus: price_variant.price | money }}
    </div>
  {% else %}
    <span class="luna-price__regular">{{ price_variant.price | money }}</span>
  {% endif %}
</div>
              <div class="mcs-buttons-{{ section.id }}">
                <button
                  type="button"
                  class="mcs-atc-{{ section.id }}"
                  data-variant-id="{{ variant.id }}"
                  {% unless variant.available %}disabled{% endunless %}
                >
                  {% if variant.available %}Add to Cart{% else %}Sold Out{% endif %}
                </button>

                <a href="{{ featured_product.url }}">View Product</a>
              </div>
            </div>
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<style>
.mcs-{{ section.id }} {
  background: {{ section.settings.bg_color }};
  padding: 48px 20px;
}

.mcs-inner-{{ section.id }} {
  max-width: 1280px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr;
  gap: 34px;
  align-items: start;
}

.mcs-kicker-{{ section.id }} {
  display: inline-block;
  margin: 0 0 14px;
  padding: 8px 16px;
  border-radius: 999px;
  background: #FDF4F6;
  border: 1px solid rgba(230,160,170,.35);
  color: #111;
  font-size: 13px;
  font-weight: 800;
}

.mcs-copy-{{ section.id }} h2 {
  margin: 0 0 16px;
  font-size: 42px;
  line-height: 1.05;
  color: #111;
}

.mcs-sub {
  font-size: 19px;
  line-height: 1.45;
  color: #555;
  margin: 0 0 18px;
}

.mcs-badges-{{ section.id }} {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 20px;
}

.mcs-badges-{{ section.id }} span {
  padding: 9px 14px;
  border-radius: 999px;
  border: 1px solid rgba(230,160,170,.4);
  background: #fff;
  font-size: 13px;
  font-weight: 800;
  color: #111;
}

.mcs-card-{{ section.id }} {
  border: 1px solid rgba(230,160,170,.28);
  border-radius: 18px;
  padding: 22px;
  background: #fff;
  color: #444;
  font-size: 16px;
  line-height: 1.6;
}

.mcs-card-{{ section.id }} p {
  margin: 0 0 14px;
}

.mcs-card-{{ section.id }} p:last-child {
  margin-bottom: 0;
}

.mcs-proof-{{ section.id }} {
  display: grid;
  grid-template-columns: 1fr;
  gap: 12px;
  margin-top: 18px;
}

.mcs-proof-{{ section.id }} div {
  border: 1px solid rgba(230,160,170,.25);
  border-radius: 14px;
  background: #fff;
  padding: 16px;
  text-align: center;
}

.mcs-proof-{{ section.id }} strong {
  display: block;
  font-size: 24px;
  color: #111;
}

.mcs-proof-{{ section.id }} span {
  font-size: 13px;
  font-weight: 700;
  color: #555;
}

.mcs-products-{{ section.id }} {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}

.mcs-product-{{ section.id }} {
  border: 1px solid rgba(0,0,0,.08);
  border-radius: 16px;
  background: #fff;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.mcs-media-{{ section.id }} {
  position: relative;
  display: block;
  aspect-ratio: 1 / 1;
  background: #fff;
  overflow: hidden;
}

.mcs-rotator-{{ section.id }} {
  position: absolute;
  inset: 0;
}

.mcs-img-{{ section.id }} {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;
  padding: 14px;
  opacity: 0;
  animation: mcsRotate{{ section.id }} 9s infinite;
}

.mcs-img-{{ section.id }}.is-1 { opacity: 1; }
.mcs-img-{{ section.id }}.is-2 { animation-delay: 3s; }
.mcs-img-{{ section.id }}.is-3 { animation-delay: 6s; }

@keyframes mcsRotate{{ section.id }} {
  0%, 28% { opacity: 1; }
  33%, 100% { opacity: 0; }
}

.mcs-bundle-{{ section.id }} {
  position: absolute;
  top: 10px;
  left: 10px;
  z-index: 4;
  padding: 7px 10px;
  border-radius: 999px;
  background: #FDF4F6;
  border: 1px solid rgba(230,160,170,.5);
  color: #111;
  font-size: 10px;
  font-weight: 900;
  text-transform: uppercase;
}

.mcs-product-info-{{ section.id }} {
  padding: 14px;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.mcs-stars-{{ section.id }} {
  min-height: 18px;
  margin-bottom: 6px;
}

.mcs-stars-{{ section.id }} .jdgm-star {
  color: #E6A0AA !important;
}

.mcs-stars-{{ section.id }} .jdgm-prev-badge__text,
.mcs-stars-{{ section.id }} .jdgm-preview-badge__text {
  font-size: 12px !important;
  color: #666 !important;
}

.mcs-product-info-{{ section.id }} h3 {
  margin: 0 0 6px;
  font-size: 15px;
  line-height: 1.25;
  min-height: 42px;
  color: #111;
}

.mcs-buttons-{{ section.id }} {
  display: grid;
  grid-template-columns: 1fr;
  gap: 8px;
  margin-top: auto;
}

.mcs-atc-{{ section.id }},
.mcs-buttons-{{ section.id }} a {
  min-height: 44px;
  border-radius: 10px;
  font-size: 13px;
  font-weight: 800;
  text-align: center;
  text-decoration: none;
  cursor: pointer;
}

.mcs-atc-{{ section.id }} {
  background: #111;
  color: #fff;
  border: none;
}

.mcs-buttons-{{ section.id }} a {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FDF4F6;
  color: #111;
  border: 1px solid rgba(230,160,170,.45);
}

@media screen and (min-width: 990px) {
  .mcs-{{ section.id }} {
    padding: 64px 48px;
  }

  .mcs-inner-{{ section.id }} {
    grid-template-columns: minmax(0, 48%) minmax(0, 52%);
    gap: 48px;
  }

  .mcs-proof-{{ section.id }} {
    grid-template-columns: repeat(3, 1fr);
  }

  .mcs-copy-{{ section.id }} h2 {
    font-size: 48px;
  }
}

@media screen and (max-width: 749px) {
  .mcs-{{ section.id }} {
    padding: 34px 16px;
  }

  .mcs-copy-{{ section.id }} h2 {
    font-size: 36px;
  }

  .mcs-sub {
    font-size: 17px;
  }

  .mcs-products-{{ section.id }} {
    display: flex;
    overflow-x: auto;
    gap: 14px;
    scroll-snap-type: x mandatory;
    padding-bottom: 10px;
  }

  .mcs-products-{{ section.id }}::-webkit-scrollbar {
    display: none;
  }

  .mcs-product-{{ section.id }} {
    flex: 0 0 78%;
    scroll-snap-align: start;
  }
}
</style>

<script>
(function() {
  var section = document.querySelector('.mcs-{{ section.id }}');
  if (!section) return;

  section.addEventListener('click', async function(event) {
    var button = event.target.closest('.mcs-atc-{{ section.id }}');
    if (!button) return;

    event.preventDefault();

    var variantId = parseInt(button.dataset.variantId, 10);
    if (!variantId) return;

    button.disabled = true;
    button.textContent = 'Adding...';

    try {
      await fetch(window.Shopify.routes.root + 'cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ items: [{ id: variantId, quantity: 1 }] })
      });

      window.location.href = window.Shopify.routes.root + 'cart';
    } catch (error) {
      button.disabled = false;
      button.textContent = 'Add to Cart';
      alert('Sorry, something went wrong. Please try again.');
    }
  });
})();
</script>

{% schema %}
{
  "name": "Mini Collection Split",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Mini Range"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Mini Tools. Major Hair Energy."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Travel light. Style easy. Compact Luna tools made for quick touch-ups, weekends away, gym bags and small spaces."
    },
    {
      "type": "textarea",
      "id": "body_1",
      "label": "Body paragraph 1",
      "default": "Discover Luna’s Mini Range — compact hair tools designed for travel, touch-ups and styling on the go. Whether you’re packing for a weekend away, heading to the gym or saving space at home, these mini styling essentials make it easy to keep your hair polished wherever you are."
    },
    {
      "type": "textarea",
      "id": "body_2",
      "label": "Body paragraph 2",
      "default": "Smart, lightweight and easy to pack, each tool is made to deliver fuss-free results with the same Luna attitude: good hair, without the big price tag."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background colour",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Mini product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "max_blocks": 2,
  "presets": [
    {
      "name": "Mini Collection Split"
    }
  ]
}
{% endschema %}