<section class="lps-{{ section.id }}">
  <div class="lps-inner-{{ section.id }}">
    {% if section.settings.kicker != blank %}
      <p class="lps-kicker-{{ section.id }}">{{ section.settings.kicker }}</p>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="lps-heading-{{ section.id }}">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <p class="lps-subheading-{{ section.id }}">{{ section.settings.subheading }}</p>
    {% endif %}

    <div class="lps-scroll-wrap-{{ section.id }}">
      <button type="button" class="lps-arrow-{{ section.id }} lps-arrow-left-{{ section.id }}" aria-label="Scroll left">‹</button>

      <div class="lps-grid-{{ section.id }}">
        {% for block in section.blocks %}
          {% assign featured_product = block.settings.product %}
          {% if featured_product != blank %}
            {% assign variant = featured_product.selected_or_first_available_variant %}
            {% assign image_1 = featured_product.featured_image %}
            {% assign image_2 = featured_product.images[1] %}
            {% assign image_3 = featured_product.images[2] %}

            <article class="lps-card-{{ section.id }}" {{ block.shopify_attributes }}>
              <a href="{{ featured_product.url }}" class="lps-media-{{ section.id }}">
                <span class="lps-badge-{{ section.id }}">Bundle &amp; Save 30%</span>

                {% if featured_product.handle == 'dryer' %}
                  <span class="lps-gift-badge-{{ section.id }}">+ FREE LUXE KIT</span>
                {% endif %}

                <div class="lps-rotator-{{ section.id }}">
                  {% if image_1 %}
                    <img class="lps-img-{{ section.id }} is-1" src="{{ image_1 | image_url: width: 900 }}" alt="{{ featured_product.title | escape }}" loading="lazy">
                  {% endif %}
                  {% if image_2 %}
                    <img class="lps-img-{{ section.id }} is-2" src="{{ image_2 | image_url: width: 900 }}" alt="{{ featured_product.title | escape }}" loading="lazy">
                  {% endif %}
                  {% if image_3 %}
                    <img class="lps-img-{{ section.id }} is-3" src="{{ image_3 | image_url: width: 900 }}" alt="{{ featured_product.title | escape }}" loading="lazy">
                  {% endif %}
                </div>

                {% if featured_product.handle == 'dryer' and section.settings.luxe_kit_gif != blank %}
                  <div class="lps-gift-tile-{{ section.id }}">
                    <img src="{{ section.settings.luxe_kit_gif }}" alt="Free Luxe Kit">
                  </div>
                {% endif %}
              </a>

              <div class="lps-info-{{ section.id }}">
                <div class="lps-stars-{{ section.id }}">
                  <div class="jdgm-widget jdgm-preview-badge" data-id="{{ featured_product.id }}">
                    {{ featured_product.metafields.judgeme.badge }}
                  </div>
                </div>

                <h3 class="lps-title-{{ section.id }}">
                  <a href="{{ featured_product.url }}">{{ featured_product.title }}</a>
                </h3>

                <p class="lps-price-{{ section.id }}">{{ featured_product.price | money }}</p>

                <div class="lps-buttons-{{ section.id }}">
                  <button
                    type="button"
                    class="lps-atc-{{ section.id }}"
                    data-variant-id="{{ variant.id }}"
                    data-product-handle="{{ featured_product.handle }}"
                    {% unless variant.available %}disabled{% endunless %}
                  >
                    {% if variant.available %}Add to Cart{% else %}Sold Out{% endif %}
                  </button>

                  <a href="{{ featured_product.url }}" class="lps-view-{{ section.id }}">View Product</a>
                </div>
              </div>
            </article>
          {% endif %}
        {% endfor %}
      </div>

      <button type="button" class="lps-arrow-{{ section.id }} lps-arrow-right-{{ section.id }}" aria-label="Scroll right">›</button>
    </div>
  </div>
</section>

<style>
.lps-{{ section.id }} {
  background: {{ section.settings.bg_color }};
  padding: 38px 0 42px;
}

.lps-inner-{{ section.id }} {
  max-width: 1320px;
  margin: 0 auto;
  padding: 0 16px;
}

.lps-kicker-{{ section.id }} {
  margin: 0 0 8px;
  text-align: center;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: #2C2C2C;
}

.lps-heading-{{ section.id }} {
  margin: 0 0 8px;
  text-align: center;
  font-size: 30px;
  line-height: 1.08;
  font-weight: 800;
  color: #111;
}

.lps-subheading-{{ section.id }} {
  margin: 0 auto 24px;
  max-width: 680px;
  text-align: center;
  font-size: 15px;
  line-height: 1.45;
  color: #555;
}

.lps-scroll-wrap-{{ section.id }} {
  position: relative;
}

.lps-grid-{{ section.id }} {
  display: flex;
  gap: 14px;
  overflow-x: auto;
  padding: 4px 4px 16px;
  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
}

.lps-grid-{{ section.id }}::-webkit-scrollbar {
  display: none;
}

.lps-card-{{ section.id }} {
  flex: 0 0 76%;
  max-width: 300px;
  scroll-snap-align: start;
  border: 1px solid rgba(0,0,0,.08);
  border-radius: 16px;
  overflow: hidden;
  background: #fff;
  display: flex;
  flex-direction: column;
}

.lps-media-{{ section.id }} {
  position: relative;
  display: block;
  aspect-ratio: 1 / 1;
  background: #fff;
  overflow: hidden;
  text-decoration: none;
}

.lps-rotator-{{ section.id }} {
  position: absolute;
  inset: 0;
  background: #fff;
}

.lps-img-{{ section.id }} {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;
  padding: 14px;
  opacity: 0;
  animation: lpsRotate{{ section.id }} 9s infinite;
}

.lps-img-{{ section.id }}.is-1 {
  opacity: 1;
}

.lps-img-{{ section.id }}.is-2 {
  animation-delay: 3s;
}

.lps-img-{{ section.id }}.is-3 {
  animation-delay: 6s;
}

@keyframes lpsRotate{{ section.id }} {
  0%, 28% { opacity: 1; }
  33%, 100% { opacity: 0; }
}

.lps-badge-{{ section.id }},
.lps-gift-badge-{{ section.id }} {
  position: absolute;
  z-index: 3;
  left: 10px;
  padding: 6px 8px;
  border-radius: 999px;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: .05em;
  text-transform: uppercase;
}

.lps-badge-{{ section.id }} {
  top: 10px;
  background: #FDF4F6;
  border: 1px solid rgba(230,160,170,.5);
  color: #111;
}

.lps-gift-badge-{{ section.id }} {
  bottom: 10px;
  background: #E6A0AA;
  color: #fff;
}

.lps-gift-tile-{{ section.id }} {
  position: absolute;
  right: 10px;
  bottom: 10px;
  z-index: 4;
  width: 58px;
  height: 58px;
  border-radius: 10px;
  overflow: hidden;
  background: #fff;
  border: 1px solid rgba(230,160,170,.35);
  box-shadow: 0 6px 16px rgba(0,0,0,.12);
}

.lps-gift-tile-{{ section.id }} img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.lps-info-{{ section.id }} {
  padding: 12px 12px 14px;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.lps-stars-{{ section.id }} {
  margin-bottom: 6px;
  min-height: 18px;
}

.lps-stars-{{ section.id }} .jdgm-star {
  color: #E6A0AA !important;
}

.lps-stars-{{ section.id }} .jdgm-prev-badge__text,
.lps-stars-{{ section.id }} .jdgm-preview-badge__text {
  font-size: 12px !important;
  color: #666 !important;
}

.lps-title-{{ section.id }} {
  margin: 0 0 6px;
  min-height: 42px;
  font-size: 15px;
  line-height: 1.25;
  font-weight: 800;
  color: #111;
}

.lps-title-{{ section.id }} a {
  color: inherit;
  text-decoration: none;
}

.lps-price-{{ section.id }} {
  margin: 0 0 12px;
  font-size: 15px;
  font-weight: 800;
  color: #E6A0AA;
}

.lps-buttons-{{ section.id }} {
  display: grid;
  grid-template-columns: 1fr;
  gap: 8px;
  margin-top: auto;
}

.lps-atc-{{ section.id }},
.lps-view-{{ section.id }} {
  width: 100%;
  min-height: 44px;
  border-radius: 10px;
  font-size: 13px;
  font-weight: 800;
  text-align: center;
  text-decoration: none;
  cursor: pointer;
}

.lps-atc-{{ section.id }} {
  background: #111;
  color: #fff;
  border: none;
}

.lps-atc-{{ section.id }}:disabled {
  opacity: .55;
  cursor: not-allowed;
}

.lps-view-{{ section.id }} {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FDF4F6;
  color: #111;
  border: 1px solid rgba(230,160,170,.45);
}

.lps-arrow-{{ section.id }} {
  position: absolute;
  top: 42%;
  z-index: 5;
  width: 34px;
  height: 34px;
  border-radius: 999px;
  border: 1px solid rgba(230,160,170,.45);
  background: rgba(255,255,255,.94);
  color: #111;
  font-size: 26px;
  line-height: 1;
  box-shadow: 0 6px 18px rgba(0,0,0,.08);
  cursor: pointer;
}

.lps-arrow-left-{{ section.id }} {
  left: 2px;
}

.lps-arrow-right-{{ section.id }} {
  right: 2px;
}

@media screen and (min-width: 990px) {
  .lps-{{ section.id }} {
    padding: 54px 48px 60px;
  }

  .lps-heading-{{ section.id }} {
    font-size: 34px;
  }

  .lps-grid-{{ section.id }} {
    display: grid;
    grid-template-columns: repeat({{ section.settings.desktop_columns }}, minmax(0, 1fr));
    gap: 20px;
    overflow: visible;
    padding: 0;
  }

  .lps-card-{{ section.id }} {
    max-width: none;
    flex: none;
  }

  .lps-arrow-{{ section.id }} {
    display: none;
  }

  .lps-buttons-{{ section.id }} {
    grid-template-columns: 1fr 1fr;
  }
}

@media (prefers-reduced-motion: reduce) {
  .lps-img-{{ section.id }} {
    animation: none !important;
  }

  .lps-img-{{ section.id }}.is-1 {
    opacity: 1 !important;
  }
}
</style>

<script>
(function() {
  var section = document.querySelector('.lps-{{ section.id }}');
  if (!section) return;

  var scroller = section.querySelector('.lps-grid-{{ section.id }}');
  var leftArrow = section.querySelector('.lps-arrow-left-{{ section.id }}');
  var rightArrow = section.querySelector('.lps-arrow-right-{{ section.id }}');

  if (scroller && leftArrow && rightArrow) {
    leftArrow.addEventListener('click', function() {
      scroller.scrollBy({ left: -300, behavior: 'smooth' });
    });

    rightArrow.addEventListener('click', function() {
      scroller.scrollBy({ left: 300, behavior: 'smooth' });
    });
  }

  section.addEventListener('click', async function(event) {
    var button = event.target.closest('.lps-atc-{{ section.id }}');
    if (!button) return;

    event.preventDefault();

    var variantId = parseInt(button.dataset.variantId, 10);
    var handle = button.dataset.productHandle;
    var luxeKitVariantId = 47990358474993;

    if (!variantId) return;

    var itemsToAdd = [{ id: variantId, quantity: 1 }];

    if (handle === 'dryer') {
      itemsToAdd.push({ id: luxeKitVariantId, quantity: 1 });
    }

    button.disabled = true;
    button.textContent = 'Adding...';

    try {
      await fetch(window.Shopify.routes.root + 'cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({ items: itemsToAdd })
      });

      window.location.href = window.Shopify.routes.root + 'cart';
    } catch (error) {
      console.error('Luna product showcase add failed:', error);
      button.disabled = false;
      button.textContent = 'Add to Cart';
      alert('Sorry, something went wrong. Please try again.');
    }
  });
})();
</script>

{% schema %}
{
  "name": "Luna Product Showcase",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Shop Luna"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tools that do more for less"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Choose your Luna tool, add to cart, or tap through to learn more."
    },
    {
      "type": "text",
      "id": "luxe_kit_gif",
      "label": "Luxe Kit GIF URL",
      "default": "https://cdn.shopify.com/s/files/1/0609/7426/8657/files/website_26_offer_1.gif?v=1775184170"
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "label": "Desktop columns",
      "min": 3,
      "max": 5,
      "step": 1,
      "default": 5
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background colour",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Luna Product Showcase"
    }
  ]
}
{% endschema %}