{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .split-media-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_top }}px 20px {{ block.settings.padding_bottom }}px;
    box-sizing: border-box;
    font-family: system-ui, sans-serif;
  }
  .split-media-inner-{{ ai_gen_id }} {
    max-width: 1100px;
    margin: 0 auto;
    text-align: center;
  }
  .split-media-heading-{{ ai_gen_id }} {
    font-family: system-ui, sans-serif;
    font-size: 22px;
    font-weight: 700;
    color: #2C2C2C;
    margin: 0 0 6px;
    letter-spacing: 0.5px;
    line-height: 1.2;
  }
  .split-media-subheading-{{ ai_gen_id }} {
    font-family: system-ui, sans-serif;
    font-size: 13px;
    font-weight: 400;
    color: #888888;
    margin: 0 0 16px;
    line-height: 1.4;
  }
  .split-media-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-bottom: 12px;
  }
  .split-media-card-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }
  .split-media-wrap-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 3 / 5;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 2px 12px rgba(0,0,0,0.08);
    border: 1px solid #F0F0F0;
  }
  .split-media-wrap-{{ ai_gen_id }} img,
  .split-media-wrap-{{ ai_gen_id }} video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
  }
  .split-media-caption-{{ ai_gen_id }} {
    font-family: system-ui, sans-serif;
    font-size: 10px;
    font-weight: 500;
    color: #888888;
    text-align: center;
    letter-spacing: 0.5px;
    line-height: 1.3;
  }
  .split-media-btn-{{ ai_gen_id }} {
    display: inline-block;
    margin-top: 16px;
    background: #CC0000;
    color: #ffffff;
    font-family: system-ui, sans-serif;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    padding: 13px 32px;
    border-radius: 4px;
    text-transform: none;
    letter-spacing: 0.5px;
  }
  @media screen and (min-width: 750px) {
    .split-media-grid-{{ ai_gen_id }} {
      gap: 16px;
    }
    .split-media-heading-{{ ai_gen_id }} {
      font-size: 28px;
    }
    .split-media-subheading-{{ ai_gen_id }} {
      font-size: 15px;
    }
  }
{% endstyle %}

<div class="split-media-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="split-media-inner-{{ ai_gen_id }}">

    <h2 class="split-media-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    <p class="split-media-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>

    <div class="split-media-grid-{{ ai_gen_id }}">
      <div class="split-media-card-{{ ai_gen_id }}">
        <div class="split-media-wrap-{{ ai_gen_id }}">
          {% if block.settings.left_image %}
            <img src="{{ block.settings.left_image | image_url: width: 800 }}"
                 alt="{{ block.settings.left_image.alt | escape }}"
                 loading="lazy">
          {% else %}
            <img src="https://cdn.shopify.com/s/files/1/0609/7426/8657/files/PHOTO-2026-04-08-16-45-17.jpg?v=1775734100"
                 alt="Luna Ionic Hair Dryer"
                 loading="lazy">
          {% endif %}
        </div>
        <p class="split-media-caption-{{ ai_gen_id }}">{{ block.settings.left_caption }}</p>
      </div>

      <div class="split-media-card-{{ ai_gen_id }}">
        <div class="split-media-wrap-{{ ai_gen_id }}">
          <video
            autoplay
            muted
            loop
            playsinline
            preload="none"
            style="width:100%;height:100%;object-fit:cover;object-position:center center;display:block;">
            <source src="{% if block.settings.right_video != blank %}{{ block.settings.right_video }}{% else %}https://cdn.shopify.com/videos/c/vp/53f6c2f3a9d14001814e56ec412647de/53f6c2f3a9d14001814e56ec412647de.SD-480p-1.5Mbps-80859303.mp4{% endif %}" type="video/mp4">
          </video>
        </div>
        <p class="split-media-caption-{{ ai_gen_id }}">{{ block.settings.right_caption }}</p>
      </div>
    </div>


  </div>
</div>

{% schema %}
{
  "name": "Split media block",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Salon Power. Real Results."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "See the value. See it in action."
    },
    {
      "type": "header",
      "content": "Left card"
    },
    {
      "type": "image_picker",
      "id": "left_image",
      "label": "Left image"
    },
    {
      "type": "text",
      "id": "left_caption",
      "label": "Left caption",
      "default": "High-performance drying for under $50"
    },
    {
      "type": "header",
      "content": "Right card"
    },
    {
      "type": "text",
      "id": "right_video",
      "label": "Right video URL (mp4)",
      "default": "https://cdn.shopify.com/videos/c/vp/53f6c2f3a9d14001814e56ec412647de/53f6c2f3a9d14001814e56ec412647de.SD-480p-1.5Mbps-80859303.mp4"
    },
    {
      "type": "text",
      "id": "right_caption",
      "label": "Right caption",
      "default": "Real demo. Real shine."
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop Dryer Offer"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background colour",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "Split media block"
    }
  ]
}
{% endschema %}
