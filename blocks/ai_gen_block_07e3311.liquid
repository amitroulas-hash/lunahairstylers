<script>
  (function() {
    class CollapsibleDropdown{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.header = this.querySelector('.ai-collapsible-dropdown__header-{{ ai_gen_id }}');
        this.content = this.querySelector('.ai-collapsible-dropdown__content-{{ ai_gen_id }}');
        this.arrow = this.querySelector('.ai-collapsible-dropdown__arrow-{{ ai_gen_id }}');

        this.setupEventListeners();
      }

      setupEventListeners() {
        this.header.addEventListener('click', () => this.toggle());
        this.header.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            this.toggle();
          }
        });
      }

      toggle() {
        const isActive = this.content.classList.contains('active');
        
        if (isActive) {
          this.content.classList.remove('active');
          this.arrow.classList.remove('active');
          this.header.setAttribute('aria-expanded', 'false');
        } else {
          this.content.classList.add('active');
          this.arrow.classList.add('active');
          this.header.setAttribute('aria-expanded', 'true');
        }
      }
    }

    customElements.define('collapsible-dropdown-{{ ai_gen_id }}', CollapsibleDropdown{{ ai_gen_id }});
  })();
</script>

