{% doc %}
  @prompt
    Create a collapsible dropdown block for a product page with a fully customisable title (editable in theme editor settings). Inside the dropdown, merchants should be able to add multiple content rows, each with a choice of content type: a Heading/Title, a Bullet point list item, a Tick/checkmark list item, or Regular paragraph copy. Each content row should match the theme's native typography styles (using existing CSS variables and font settings for headings, body text, etc). The block should have a clickable header with a toggle arrow that expands and collapses the content. All content rows should be editable in the Shopify theme editor sidebar.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collapsible-dropdown-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    border: 1px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    background-color: {{ block.settings.background_color }};
    overflow: hidden;
  }

  .ai-collapsible-dropdown__header-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: {{ block.settings.header_padding }}px;
    cursor: pointer;
    background-color: {{ block.settings.header_background_color }};
    transition: background-color 0.3s ease;
  }

  .ai-collapsible-dropdown__header-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.header_hover_background_color }};
  }

  .ai-collapsible-dropdown__title-{{ ai_gen_id }} {
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: {{ block.settings.title_font_size }}px;
    font-weight: var(--font-heading-weight);
    color: {{ block.settings.title_color }};
  }

  .ai-collapsible-dropdown__arrow-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    transition: transform 0.3s ease;
    flex-shrink: 0;
    color: {{ block.settings.arrow_color }};
  }

  .ai-collapsible-dropdown__arrow-{{ ai_gen_id }}.active {
    transform: rotate(180deg);
  }

  .ai-collapsible-dropdown__content-{{ ai_gen_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .ai-collapsible-dropdown__content-{{ ai_gen_id }}.active {
    max-height: 2000px;
  }

  .ai-collapsible-dropdown__content-inner-{{ ai_gen_id }} {
    padding: {{ block.settings.content_padding }}px;
  }

  .ai-collapsible-dropdown__row-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.row_spacing }}px;
  }

  .ai-collapsible-dropdown__row-{{ ai_gen_id }}:last-child {
    margin-bottom: 0;
  }

  .ai-collapsible-dropdown__heading-{{ ai_gen_id }} {
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: calc(var(--font-heading-scale) * 1.6rem);
    font-weight: var(--font-heading-weight);
    color: {{ block.settings.content_text_color }};
  }

  .ai-collapsible-dropdown__paragraph-{{ ai_gen_id }} {
    margin: 0;
    font-family: var(--font-body-family);
    font-size: calc(var(--font-body-scale) * 1.4rem);
    line-height: 1.6;
    color: {{ block.settings.content_text_color }};
  }

  .ai-collapsible-dropdown__list-{{ ai_gen_id }} {
    margin: 0;
    padding-left: 0;
    list-style: none;
  }

  .ai-collapsible-dropdown__list-item-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-family: var(--font-body-family);
    font-size: calc(var(--font-body-scale) * 1.4rem);
    line-height: 1.6;
    color: {{ block.settings.content_text_color }};
  }

  .ai-collapsible-dropdown__bullet-{{ ai_gen_id }} {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: {{ block.settings.bullet_color }};
    flex-shrink: 0;
    margin-top: 0.6em;
  }

  .ai-collapsible-dropdown__checkmark-{{ ai_gen_id }} {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    color: {{ block.settings.checkmark_color }};
    margin-top: 0.2em;
  }
{% endstyle %}

