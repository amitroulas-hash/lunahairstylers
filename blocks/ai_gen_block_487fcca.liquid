{% doc %}
  @prompt
    Create a before and after image slider block for a product page. It should have a draggable/swipeable divider that reveals the "before" image on one side and the "after" image on the other side. The slider handle should be a visible drag icon in the centre. Both the before and after images should be fully customisable in the theme editor settings, along with optional labels (e.g. "Before" and "After") that overlay each side. The block should be fully responsive and work smoothly on mobile with touch/swipe gestures. Style it to match the theme's existing design aesthetic.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

 {% style %}
  .ai-before-after-slider-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
    user-select: none;
    touch-action: none;
  }

  .ai-before-after-container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: {{ block.settings.aspect_ratio }};
    overflow: hidden;
  }

  .ai-before-after-image-wrapper-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .ai-before-after-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-before-after-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-before-after-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-before-after-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
    font-family: {{ block.settings.label_font.family }}, {{ block.settings.label_font.fallback_families }};
  }

  .ai-before-after-after-wrapper-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    clip-path: inset(0 0 0 50%);
  }

  .ai-before-after-label-{{ ai_gen_id }} {
    position: absolute;
    top: {{ block.settings.label_position_vertical }}px;
    padding: {{ block.settings.label_padding }}px {{ block.settings.label_padding | times: 1.5 }}px;
    background-color: {{ block.settings.label_background_color }};
    color: {{ block.settings.label_text_color }};
    font-size: {{ block.settings.label_font_size }}px;
    font-weight: {{ block.settings.label_font_weight }};
    border-radius: {{ block.settings.label_border_radius }}px;
    pointer-events: none;
    z-index: 2;
    font-family: {{ block.settings.label_font.family }}, {{ block.settings.label_font.fallback_families }};
    opacity: {{ block.settings.label_opacity }};
  }

  .ai-before-after-label-before-{{ ai_gen_id }} {
    left: {{ block.settings.label_position_horizontal }}px;
  }

  .ai-before-after-label-after-{{ ai_gen_id }} {
    right: {{ block.settings.label_position_horizontal }}px;
  }

  .ai-before-after-divider-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 50%;
    width: {{ block.settings.divider_width }}px;
    height: 100%;
    background-color: {{ block.settings.divider_color }};
    transform: translateX(-50%);
    cursor: ew-resize;
    z-index: 3;
  }

  .ai-before-after-handle-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: {{ block.settings.handle_size }}px;
    height: {{ block.settings.handle_size }}px;
    background-color: {{ block.settings.handle_color }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
    cursor: ew-resize;
  }

  .ai-before-after-handle-icon-{{ ai_gen_id }} {
    width: {{ block.settings.handle_size | times: 0.6 }}px;
    height: {{ block.settings.handle_size | times: 0.6 }}px;
    color: {{ block.settings.handle_icon_color }};
  }

  @media screen and (min-width: 990px) {
    .ai-before-after-slider-{{ ai_gen_id }} {
      width: 100%;
      max-width: 620px;
      margin: 0 auto 36px;
    }

    .ai-before-after-container-{{ ai_gen_id }} {
      aspect-ratio: 4 / 3;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-before-after-slider-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-before-after-label-{{ ai_gen_id }} {
      font-size: {{ block.settings.label_font_size | times: 0.9 }}px;
      padding: {{ block.settings.label_padding | times: 0.8 }}px {{ block.settings.label_padding | times: 1.2 }}px;
    }

    .ai-before-after-handle-{{ ai_gen_id }} {
      width: {{ block.settings.handle_size | times: 0.85 }}px;
      height: {{ block.settings.handle_size | times: 0.85 }}px;
    }

    .ai-before-after-handle-icon-{{ ai_gen_id }} {
      width: {{ block.settings.handle_size | times: 0.5 }}px;
      height: {{ block.settings.handle_size | times: 0.5 }}px;
    }
  }
{% endstyle %}

<before-after-slider-{{ ai_gen_id }} class="ai-before-after-slider-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-before-after-container-{{ ai_gen_id }}">
    <div class="ai-before-after-image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.before_image %}
        <img
          src="{{ block.settings.before_image | image_url: width: 2000 }}"
          alt="{{ block.settings.before_image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.before_image.width }}"
          height="{{ block.settings.before_image.height }}"
          class="ai-before-after-image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-before-after-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-before-after-empty-state-{{ ai_gen_id }}">
            Add a before image
          </div>
        </div>
      {% endif %}
      {% if block.settings.before_label != blank and block.settings.show_labels %}
        <div class="ai-before-after-label-{{ ai_gen_id }} ai-before-after-label-before-{{ ai_gen_id }}">
          {{ block.settings.before_label }}
        </div>
      {% endif %}
    </div>

    <div class="ai-before-after-after-wrapper-{{ ai_gen_id }}">
      <div class="ai-before-after-image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.after_image %}
          <img
            src="{{ block.settings.after_image | image_url: width: 2000 }}"
            alt="{{ block.settings.after_image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.after_image.width }}"
            height="{{ block.settings.after_image.height }}"
            class="ai-before-after-image-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-before-after-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
            <div class="ai-before-after-empty-state-{{ ai_gen_id }}">
              Add an after image
            </div>
          </div>
        {% endif %}
        {% if block.settings.after_label != blank and block.settings.show_labels %}
          <div class="ai-before-after-label-{{ ai_gen_id }} ai-before-after-label-after-{{ ai_gen_id }}">
            {{ block.settings.after_label }}
          </div>
        {% endif %}
      </div>
    </div>

    <div class="ai-before-after-divider-{{ ai_gen_id }}">
      <div class="ai-before-after-handle-{{ ai_gen_id }}">
        <svg class="ai-before-after-handle-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </div>
    </div>
  </div>
</before-after-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class BeforeAfterSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.isDragging = false;
        this.container = null;
        this.divider = null;
        this.afterWrapper = null;
      }

      connectedCallback() {
        this.container = this.querySelector('.ai-before-after-container-{{ ai_gen_id }}');
        this.divider = this.querySelector('.ai-before-after-divider-{{ ai_gen_id }}');
        this.afterWrapper = this.querySelector('.ai-before-after-after-wrapper-{{ ai_gen_id }}');

        if (!this.container || !this.divider || !this.afterWrapper) return;

        this.setupEventListeners();
      }

      setupEventListeners() {
        this.divider.addEventListener('mousedown', this.startDrag.bind(this));
        this.divider.addEventListener('touchstart', this.startDrag.bind(this), { passive: false });

        document.addEventListener('mousemove', this.onDrag.bind(this));
        document.addEventListener('touchmove', this.onDrag.bind(this), { passive: false });

        document.addEventListener('mouseup', this.stopDrag.bind(this));
        document.addEventListener('touchend', this.stopDrag.bind(this));

        this.container.addEventListener('click', this.handleClick.bind(this));
      }

      startDrag(e) {
        this.isDragging = true;
        e.preventDefault();
      }

      stopDrag() {
        this.isDragging = false;
      }

      onDrag(e) {
        if (!this.isDragging) return;

        e.preventDefault();
        this.updatePosition(e);
      }

      handleClick(e) {
        if (e.target.closest('.ai-before-after-divider-{{ ai_gen_id }}')) return;
        this.updatePosition(e);
      }

      updatePosition(e) {
        const rect = this.container.getBoundingClientRect();
        let clientX;

        if (e.type.includes('touch')) {
          clientX = e.touches[0]?.clientX || e.changedTouches[0]?.clientX;
        } else {
          clientX = e.clientX;
        }

        let x = clientX - rect.left;
        x = Math.max(0, Math.min(x, rect.width));

        const percentage = (x / rect.width) * 100;

        this.divider.style.left = percentage + '%';
        this.afterWrapper.style.clipPath = `inset(0 0 0 ${percentage}%)`;
      }
    }

    customElements.define('before-after-slider-{{ ai_gen_id }}', BeforeAfterSlider{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Before and after slider",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "before_image",
      "label": "Before image"
    },
    {
      "type": "image_picker",
      "id": "after_image",
      "label": "After image"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Aspect ratio",
      "options": [
        {
          "value": "1 / 1",
          "label": "Square (1:1)"
        },
        {
          "value": "4 / 3",
          "label": "Landscape (4:3)"
        },
        {
          "value": "16 / 9",
          "label": "Widescreen (16:9)"
        },
        {
          "value": "3 / 4",
          "label": "Portrait (3:4)"
        },
        {
          "value": "2 / 3",
          "label": "Tall (2:3)"
        }
      ],
      "default": "4 / 3"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Labels"
    },
    {
      "type": "checkbox",
      "id": "show_labels",
      "label": "Show labels",
      "default": true
    },
    {
      "type": "text",
      "id": "before_label",
      "label": "Before label",
      "default": "Before"
    },
    {
      "type": "text",
      "id": "after_label",
      "label": "After label",
      "default": "After"
    },
    {
      "type": "font_picker",
      "id": "label_font",
      "label": "Label font",
      "default": "assistant_n4"
    },
    {
      "type": "range",
      "id": "label_font_size",
      "label": "Font size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "select",
      "id": "label_font_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "600"
    },
    {
      "type": "range",
      "id": "label_padding",
      "label": "Padding",
      "min": 4,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "label_border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "label_position_vertical",
      "label": "Vertical position",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "label_position_horizontal",
      "label": "Horizontal position",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "label_opacity",
