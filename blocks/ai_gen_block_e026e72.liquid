{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

<style>
  .vao-{{ ai_gen_id }} {
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_right }}px {{ block.settings.padding_bottom }}px {{ block.settings.padding_left }}px;
    margin: {{ block.settings.margin_top }}px 0 {{ block.settings.margin_bottom }}px;
  }
  .vao-wrap-{{ ai_gen_id }} {
    max-width: {{ block.settings.desktop_max_width }}%;
    margin: 0 auto;
    text-align: {{ block.settings.desktop_alignment }};
  }
  .vao-media-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    border-radius: 8px;
    overflow: hidden;
  }
  .vao-media-{{ ai_gen_id }} video,
  .vao-media-{{ ai_gen_id }} iframe {
    width: 100%;
    display: block;
  }
  .vao-caption-{{ ai_gen_id }} {
    margin-top: 10px;
    font-size: 14px;
    color: #555;
    text-align: {{ block.settings.caption_alignment }};
  }
  @media (max-width: 749px) {
    .vao-wrap-{{ ai_gen_id }} {
      max-width: {{ block.settings.mobile_max_width }}%;
    }
  }
</style>

<div class="vao-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="vao-wrap-{{ ai_gen_id }}">
    <div class="vao-media-{{ ai_gen_id }}">
      {% if block.settings.video_source == 'shopify' and block.settings.shopify_video != blank %}
        {% assign video_obj = block.settings.shopify_video %}
        <video
          {% if block.settings.autoplay %}autoplay{% endif %}
          {% if block.settings.loop %}loop{% endif %}
          {% if block.settings.muted %}muted playsinline{% endif %}
          {% if block.settings.show_controls %}controls{% endif %}
          style="aspect-ratio: {{ block.settings.desktop_aspect_ratio | replace: '_', '/' }};"
        >
          <source src="{{ video_obj }}" type="video/mp4">
        </video>
      {% elsif block.settings.video_source == 'external' and block.settings.external_video_url != blank %}
        {% assign video_url = block.settings.external_video_url %}
        {% if video_url contains 'youtu' %}
          {% assign video_id = video_url | split: 'v=' | last | split: '&' | first %}
          {% if video_url contains 'youtu.be' %}
            {% assign video_id = video_url | split: 'youtu.be/' | last | split: '?' | first %}
          {% endif %}
          <iframe
            src="https://www.youtube.com/embed/{{ video_id }}?{% if block.settings.autoplay %}autoplay=1&{% endif %}{% if block.settings.loop %}loop=1&playlist={{ video_id }}&{% endif %}{% if block.settings.muted %}mute=1&{% endif %}"
            style="aspect-ratio: {{ block.settings.desktop_aspect_ratio | replace: '_', '/' }}; width: 100%; border: none;"
            allowfullscreen
          ></iframe>
        {% endif %}
      {% endif %}
    </div>
    {% if block.settings.caption != blank %}
      <p class="vao-caption-{{ ai_gen_id }}">{{ block.settings.caption }}</p>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Video All Options",
  "settings": [
    { "type": "select", "id": "video_source", "label": "Video source", "options": [{"value": "shopify", "label": "Shopify hosted"}, {"value": "external", "label": "External (YouTube)"}], "default": "shopify" },
    { "type": "video", "id": "shopify_video", "label": "Shopify video" },
    { "type": "text", "id": "external_video_url", "label": "YouTube URL" },
    { "type": "select", "id": "desktop_aspect_ratio", "label": "Desktop aspect ratio", "options": [{"value": "16_9", "label": "16:9"}, {"value": "1_1", "label": "1:1"}, {"value": "9_16", "label": "9:16"}], "default": "1_1" },
    { "type": "range", "id": "desktop_max_width", "min": 20, "max": 100, "step": 5, "label": "Desktop max width %", "default": 100 },
    { "type": "select", "id": "desktop_alignment", "label": "Desktop alignment", "options": [{"value": "left", "label": "Left"}, {"value": "center", "label": "Center"}, {"value": "right", "label": "Right"}], "default": "center" },
    { "type": "select", "id": "mobile_aspect_ratio", "label": "Mobile aspect ratio", "options": [{"value": "16_9", "label": "16:9"}, {"value": "1_1", "label": "1:1"}, {"value": "9_16", "label": "9:16"}], "default": "9_16" },
    { "type": "range", "id": "mobile_max_width", "min": 20, "max": 100, "step": 5, "label": "Mobile max width %", "default": 100 },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "label": "Padding top", "default": 0 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "label": "Padding bottom", "default": 36 },
    { "type": "range", "id": "padding_left", "min": 0, "max": 100, "step": 4, "label": "Padding left", "default": 0 },
    { "type": "range", "id": "padding_right", "min": 0, "max": 100, "step": 4, "label": "Padding right", "default": 0 },
    { "type": "range", "id": "margin_top", "min": 0, "max": 100, "step": 4, "label": "Margin top", "default": 0 },
    { "type": "range", "id": "margin_bottom", "min": 0, "max": 100, "step": 4, "label": "Margin bottom", "default": 0 },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay", "default": false },
    { "type": "checkbox", "id": "loop", "label": "Loop", "default": false },
    { "type": "checkbox", "id": "muted", "label": "Muted", "default": true },
    { "type": "checkbox", "id": "show_controls", "label": "Show controls", "default": true },
    { "type": "text", "id": "caption", "label": "Caption" },
    { "type": "select", "id": "caption_alignment", "label": "Caption alignment", "options": [{"value": "left", "label": "Left"}, {"value": "center", "label": "Center"}, {"value": "right", "label": "Right"}], "default": "center" }
  ],
  "presets": [{ "name": "Video All Options" }]
}
{% endschema %}
