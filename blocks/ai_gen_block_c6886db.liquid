X{% doc %}
  @prompt
    Create a custom product media gallery section for a Shopify product page that includes a theme editor setting to switch between multiple layout styles: Stacked (images displayed one below the other vertically as you scroll), Carousel (swipeable/slideable image gallery with navigation arrows and dots), and Grid (images displayed in a 2-column grid). The section should use the product's existing images, work well on both mobile and desktop, and include smooth transitions. The layout style should be selectable via a dropdown setting in the theme editor.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-gallery-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-product-gallery__container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
  }

  .ai-product-gallery__stacked-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.image_spacing }}px;
  }

  .ai-product-gallery__stacked-{{ ai_gen_id }} .ai-product-gallery__image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-product-gallery__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: {{ block.settings.image_spacing }}px;
  }

  .ai-product-gallery__grid-{{ ai_gen_id }} .ai-product-gallery__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-product-gallery__carousel-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-product-gallery__carousel-track-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.4s ease;
  }

  .ai-product-gallery__carousel-{{ ai_gen_id }} .ai-product-gallery__image-wrapper-{{ ai_gen_id }} {
    flex: 0 0 100%;
    position: relative;
  }

  .ai-product-gallery__image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .ai-product-gallery__nav-button-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background-color: {{ block.settings.nav_button_bg }};
    color: {{ block.settings.nav_button_color }};
    border: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    transition: opacity 0.3s ease;
    opacity: 0.9;
  }

  .ai-product-gallery__nav-button-{{ ai_gen_id }}:hover {
    opacity: 1;
  }

  .ai-product-gallery__nav-button-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-product-gallery__nav-button--prev-{{ ai_gen_id }} {
    left: 16px;
  }

  .ai-product-gallery__nav-button--next-{{ ai_gen_id }} {
    right: 16px;
  }

  .ai-product-gallery__dots-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 16px;
  }

  .ai-product-gallery__dot-{{ ai_gen_id }} {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    border: none;
    cursor: pointer;
    padding: 0;
    opacity: 0.4;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .ai-product-gallery__dot-{{ ai_gen_id }}.active {
    opacity: 1;
    transform: scale(1.2);
  }

  .ai-product-gallery__empty-state-{{ ai_gen_id }} {
    background-color: #f4f4f4;
    border-radius: {{ block.settings.border_radius }}px;
    padding: 60px 20px;
    text-align: center;
    color: #666;
  }

  .ai-product-gallery__empty-state-{{ ai_gen_id }} svg {
    width: 100%;
    max-width: 300px;
    height: auto;
    margin-bottom: 16px;
  }

  @media screen and (max-width: 749px) {
    .ai-product-gallery-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-product-gallery__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.grid_columns_mobile }}, 1fr);
    }

    .ai-product-gallery__nav-button-{{ ai_gen_id }} {
      width: 32px;
      height: 32px;
    }

    .ai-product-gallery__nav-button--prev-{{ ai_gen_id }} {
      left: 8px;
    }

    .ai-product-gallery__nav-button--next-{{ ai_gen_id }} {
      right: 8px;
    }
  }
{% endstyle %}

<product-media-gallery-{{ ai_gen_id }}
  class="ai-product-gallery-{{ ai_gen_id }}"
  data-layout="{{ block.settings.layout_style }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-product-gallery__container-{{ ai_gen_id }}">
    {% if product.media.size > 0 %}
      {% if block.settings.layout_style == 'stacked' %}
        <div class="ai-product-gallery__stacked-{{ ai_gen_id }}">
          {% for media in product.media %}
            <div class="ai-product-gallery__image-wrapper-{{ ai_gen_id }}">
              {% if media.media_type == 'image' %}
                <img
                  src="{{ media | image_url: width: 1200 }}"
                  alt="{{ media.alt | escape }}"
                  width="{{ media.width }}"
                  height="{{ media.height }}"
                  loading="lazy"
                  class="ai-product-gallery__image-{{ ai_gen_id }}"
                >
              {% elsif media.media_type == 'video' or media.media_type == 'external_video' %}
                {{ media | media_tag: image_size: '1200x', autoplay: false, loop: false, controls: true }}
              {% elsif media.media_type == 'model' %}
                {{ media | media_tag }}
              {% endif %}
            </div>
          {% endfor %}
        </div>

      {% elsif block.settings.layout_style == 'grid' %}
        <div class="ai-product-gallery__grid-{{ ai_gen_id }}">
          {% for media in product.media %}
            <div class="ai-product-gallery__image-wrapper-{{ ai_gen_id }}">
              {% if media.media_type == 'image' %}
                <img
                  src="{{ media | image_url: width: 800 }}"
                  alt="{{ media.alt | escape }}"
                  width="{{ media.width }}"
                  height="{{ media.height }}"
                  loading="lazy"
                  class="ai-product-gallery__image-{{ ai_gen_id }}"
                >
              {% elsif media.media_type == 'video' or media.media_type == 'external_video' %}
                {{ media | media_tag: image_size: '800x', autoplay: false, loop: false, controls: true }}
              {% elsif media.media_type == 'model' %}
                {{ media | media_tag }}
              {% endif %}
            </div>
          {% endfor %}
        </div>

      {% elsif block.settings.layout_style == 'carousel' %}
        <div class="ai-product-gallery__carousel-{{ ai_gen_id }}">
          <div class="ai-product-gallery__carousel-track-{{ ai_gen_id }}">
            {% for media in product.media %}
              <div class="ai-product-gallery__image-wrapper-{{ ai_gen_id }}">
                {% if media.media_type == 'image' %}
                  <img
                    src="{{ media | image_url: width: 1200 }}"
                    alt="{{ media.alt | escape }}"
                    width="{{ media.width }}"
                    height="{{ media.height }}"
                    loading="lazy"
                    class="ai-product-gallery__image-{{ ai_gen_id }}"
                  >
                {% elsif media.media_type == 'video' or media.media_type == 'external_video' %}
                  {{ media | media_tag: image_size: '1200x', autoplay: false, loop: false, controls: true }}
                {% elsif media.media_type == 'model' %}
                  {{ media | media_tag }}
                {% endif %}
              </div>
            {% endfor %}
          </div>

          {% if product.media.size > 1 %}
            <button
              class="ai-product-gallery__nav-button-{{ ai_gen_id }} ai-product-gallery__nav-button--prev-{{ ai_gen_id }}"
              aria-label="Previous image"
            >
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M12.5 15L7.5 10L12.5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <button
              class="ai-product-gallery__nav-button-{{ ai_gen_id }} ai-product-gallery__nav-button--next-{{ ai_gen_id }}"
              aria-label="Next image"
            >
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M7.5 15L12.5 10L7.5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          {% endif %}
        </div>

        {% if product.media.size > 1 %}
          <div class="ai-product-gallery__dots-{{ ai_gen_id }}">
            {% for media in product.media %}
              <button
                class="ai-product-gallery__dot-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
                aria-label="Go to image {{ forloop.index }}"
                data-index="{{ forloop.index0 }}"
              ></button>
            {% endfor %}
          </div>
        {% endif %}
      {% endif %}

    {% else %}
      <div class="ai-product-gallery__empty-state-{{ ai_gen_id }}">
        {{ 'product-1' | placeholder_svg_tag }}
        <p>Add product images to display them here</p>
      </div>
    {% endif %}
  </div>
</product-media-gallery-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductMediaGallery{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.layout = this.dataset.layout;
      }

      connectedCallback() {
        if (this.layout === 'carousel') {
          this.initCarousel();
        }
      }

      initCarousel() {
        this.track = this.querySelector('.ai-product-gallery__carousel-track-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-product-gallery__nav-button--prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-product-gallery__nav-button--next-{{ ai_gen_id }}');
        this.dots = this.querySelectorAll('.ai-product-gallery__dot-{{ ai_gen_id }}');
        this.slides = this.querySelectorAll('.ai-product-gallery__carousel-track-{{ ai_gen_id }} .ai-product-gallery__image-wrapper-{{ ai_gen_id }}');

        if (!this.track || this.slides.length === 0) return;

        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => this.goToPrevious());
        }

        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => this.goToNext());
        }

        this.dots.forEach((dot, index) => {
          dot.addEventListener('click', () => this.goToSlide(index));
        });

        this.setupSwipe();
        this.updateButtons();
      }

      goToSlide(index) {
        this.currentIndex = index;
        this.track.style.transform = `translateX(-${this.currentIndex * 100}%)`;
        this.updateDots();
        this.updateButtons();
      }

      goToNext() {
        if (this.currentIndex < this.slides.length - 1) {
          this.currentIndex++;
          this.goToSlide(this.currentIndex);
        }
      }

      goToPrevious() {
        if (this.currentIndex > 0) {
          this.currentIndex--;
          this.goToSlide(this.currentIndex);
        }
      }

      updateDots() {
        this.dots.forEach((dot, index) => {
          if (index === this.currentIndex) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }

      updateButtons() {
        if (this.prevButton) {
          this.prevButton.disabled = this.currentIndex === 0;
        }
        if (this.nextButton) {
          this.nextButton.disabled = this.currentIndex === this.slides.length - 1;
        }
      }

      setupSwipe() {
        let startX = 0;
        let currentX = 0;
        let isDragging = false;

        this.track.addEventListener('touchstart', (e) => {
          startX = e.touches[0].clientX;
          isDragging = true;
        });

        this.track.addEventListener('touchmove', (e) => {
          if (!isDragging) return;
          currentX = e.touches[0].clientX;
        });

        this.track.addEventListener('touchend', () => {
          if (!isDragging) return;
          isDragging = false;

          const diff = startX - currentX;
          const threshold = 50;

          if (diff > threshold) {
            this.goToNext();
          } else if (diff < -threshold) {
            this.goToPrevious();
          }
        });

        let mouseStartX = 0;
        let mouseCurrentX = 0;
        let isMouseDragging = false;

        this.track.addEventListener('mousedown', (e) => {
          mouseStartX = e.clientX;
          isMouseDragging = true;
          e.preventDefault();
        });

        this.track.addEventListener('mousemove', (e) => {
          if (!isMouseDragging) return;
          mouseCurrentX = e.clientX;
        });

        this.track.addEventListener('mouseup', () => {
          if (!isMouseDragging) return;
          isMouseDragging = false;

          const diff = mouseStartX - mouseCurrentX;
          const threshold = 50;

          if (diff > threshold) {
            this.goToNext();
          } else if (diff < -threshold) {
            this.goToPrevious();
          }
        });

        this.track.addEventListener('mouseleave', () => {
          isMouseDragging = false;
        });
      }
    }

    customElements.define('product-media-gallery-{{ ai_gen_id }}', ProductMediaGallery{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Product media gallery",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout style",
      "options": [
        {
          "value": "stacked",
          "label": "Stacked"
        },
        {
          "value": "carousel",
          "label": "Carousel"
        },
        {
          "value": "grid",
          "label": "Grid"
        }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "image_spacing",
      "label": "Image spacing",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Grid settings"
    },
    {
      "type": "select",
      "id": "grid_columns_mobile",
      "label": "Columns on mobile",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2"
    },
    {
      "type": "header",
      "content": "Carousel controls"
    },
    {
      "type": "color",
      "id": "nav_button_bg",
      "label": "Navigation button background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "nav_button_color",
      "label": "Navigation button icon",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "Dot color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Product media gallery"
    }
  ]
}
{% endschema %}
