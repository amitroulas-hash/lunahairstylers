{% doc %}
  @prompt
    Create an animated horizontal scrolling marquee ribbon banner block for a luxury hair brand landing page. The ribbon should continuously scroll text from right to left in a smooth infinite loop animation at a calm, elegant pace (animation duration of 35-40 seconds for a full loop — slow enough to feel premium and readable, not rushed). The scrolling text should repeat multiple times: "Luna Ionic Hair Dryer — Only $49.99  ✦  FREE Luxe Hair Kit Included  ✦  Limited Offer  ✦  " Styling: Background colour: deep charcoal #2C2C2C. Text colour: rose-gold #C4956A. Font: modern sans-serif, uppercase, letter-spacing 2px, font size 13px, font weight 500. Ribbon height: compact approximately 36-40px tall, vertically centred text. Smooth CSS keyframe animation, infinite loop, linear timing, no pause on hover. Fully responsive on mobile. No border radius — full width edge to edge. Premium luxe feel for a high-end beauty brand.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-marquee-ribbon-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    height: {{ block.settings.ribbon_height }}px;
    overflow: hidden;
    position: relative;
  }

  .ai-marquee-ribbon-track-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    height: 100%;
    width: max-content;
    animation: ai-marquee-scroll-{{ ai_gen_id }} {{ block.settings.animation_duration }}s linear infinite;
  }

  .ai-marquee-ribbon-content-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    white-space: nowrap;
    padding: 0 {{ block.settings.item_spacing }}px;
  }

  .ai-marquee-ribbon-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ block.settings.font_weight }};
    text-transform: uppercase;
    letter-spacing: {{ block.settings.letter_spacing }}px;
    font-family: {{ block.settings.font_family.family }}, {{ block.settings.font_family.fallback_families }};
    margin: 0;
  }

  @keyframes ai-marquee-scroll-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-marquee-ribbon-{{ ai_gen_id }} {
      height: {{ block.settings.ribbon_height_mobile }}px;
    }

    .ai-marquee-ribbon-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size_mobile }}px;
    }
  }
{% endstyle %}

<marquee-ribbon-{{ ai_gen_id }}
  class="ai-marquee-ribbon-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-marquee-ribbon-track-{{ ai_gen_id }}">
    {% for i in (1..2) %}
      <div class="ai-marquee-ribbon-content-{{ ai_gen_id }}">
        <p class="ai-marquee-ribbon-text-{{ ai_gen_id }}">
          {{ block.settings.marquee_text }}
        </p>
      </div>
    {% endfor %}
  </div>
</marquee-ribbon-{{ ai_gen_id }}>

<script>
  (function() {
    class MarqueeRibbon{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.duplicateContent();
      }

      duplicateContent() {
        const track = this.querySelector('.ai-marquee-ribbon-track-{{ ai_gen_id }}');
        const content = this.querySelector('.ai-marquee-ribbon-content-{{ ai_gen_id }}');
        
        if (!track || !content) return;

        const contentWidth = content.offsetWidth;
        const viewportWidth = this.offsetWidth;
        const repetitionsNeeded = Math.ceil((viewportWidth * 2) / contentWidth) + 2;

        for (let i = 2; i < repetitionsNeeded; i++) {
          const clone = content.cloneNode(true);
          track.appendChild(clone);
        }
      }
    }

    customElements.define('marquee-ribbon-{{ ai_gen_id }}', MarqueeRibbon{{ ai_gen_id }});
  })();
</script>

