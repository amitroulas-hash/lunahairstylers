{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}


<style>
  .bdv-{{ ai_gen_id }} {
    background: {{ block.settings.bg_color }};
    padding: 32px 16px 36px;
    text-align: center;
    font-family: inherit;
  }

  .bdv-inner-{{ ai_gen_id }} {
    max-width: 1180px;
    margin: 0 auto;
  }

  .bdv-headline-{{ ai_gen_id }} {
    font-size: {{ block.settings.headline_size }}px;
    font-weight: 800;
    color: {{ block.settings.headline_color }};
    letter-spacing: 0.08em;
    margin: 0 0 8px;
    text-transform: uppercase;
  }

  .bdv-subline-{{ ai_gen_id }} {
    font-size: 15px;
    color: #666;
    margin: 0 0 18px;
    line-height: 1.4;
  }

  .bdv-video-{{ ai_gen_id }} {
    width: 100%;
    max-width: 620px;
    margin: 0 auto;
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    display: block;
    background: #f7f7f7;
  }

  .bdv-video-{{ ai_gen_id }} video {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    display: block;
  }

  .bdv-caption-{{ ai_gen_id }} {
    max-width: 620px;
    margin: 12px auto 0;
    font-size: {{ block.settings.caption_size }}px;
    color: {{ block.settings.caption_color }};
    font-style: italic;
    letter-spacing: 0.02em;
    line-height: 1.4;
  }

  @media screen and (min-width: 990px) {
    .bdv-{{ ai_gen_id }} {
      padding: 48px 24px 56px;
    }

    .bdv-video-{{ ai_gen_id }} {
      max-width: 520px;
    }

    .bdv-video-{{ ai_gen_id }} video {
      aspect-ratio: 9 / 16;
      max-height: 680px;
    }
  }

  @media screen and (max-width: 749px) {
    .bdv-{{ ai_gen_id }} {
      padding: 28px 15px 34px;
    }

    .bdv-headline-{{ ai_gen_id }} {
      font-size: 22px;
      line-height: 1.2;
      padding: 0 6px;
    }

    .bdv-subline-{{ ai_gen_id }} {
      font-size: 14px;
      margin-bottom: 16px;
    }

    .bdv-video-{{ ai_gen_id }} video {
      aspect-ratio: 4 / 5;
      object-fit: cover;
    }

    .bdv-caption-{{ ai_gen_id }} {
      font-size: 13px;
      padding: 0 4px;
    }
  }
</style>

<div class="bdv-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="bdv-inner-{{ ai_gen_id }}">
    {% if block.settings.headline != blank %}
      <h2 class="bdv-headline-{{ ai_gen_id }}">{{ block.settings.headline }}</h2>
      <p class="bdv-subline-{{ ai_gen_id }}">Fast, smooth results you can see.</p>
    {% endif %}

    <div class="bdv-video-{{ ai_gen_id }}">
      <video
        autoplay
        loop
        muted
        playsinline
        {% if block.settings.show_controls %}controls{% endif %}
      >
        <source src="{{ block.settings.video_url }}" type="video/mp4">
      </video>
    </div>

    {% if block.settings.caption != blank %}
      <p class="bdv-caption-{{ ai_gen_id }}">{{ block.settings.caption }}</p>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Blow Dry Video",
  "settings": [
    { "type": "text", "id": "headline", "label": "Headline", "default": "REAL RESULTS. REAL STYLING" },
    { "type": "range", "id": "headline_size", "min": 14, "max": 36, "step": 2, "label": "Headline size", "default": 20 },
    { "type": "color", "id": "headline_color", "label": "Headline colour", "default": "#2C2C2C" },
    { "type": "text", "id": "video_url", "label": "Video URL", "default": "https://cdn.shopify.com/videos/c/vp/8a15b2a63f2843a9bdb09b451e92b4eb/8a15b2a63f2843a9bdb09b451e92b4eb.HD-720p-4.5Mbps-78138343.mp4" },
    { "type": "text", "id": "caption", "label": "Caption", "default": "Fast drying with less frizz and more shine." },
    { "type": "range", "id": "caption_size", "min": 11, "max": 18, "step": 1, "label": "Caption size", "default": 13 },
    { "type": "color", "id": "caption_color", "label": "Caption colour", "default": "#888888" },
    { "type": "color", "id": "bg_color", "label": "Background colour", "default": "#FFFFFF" },
    { "type": "range", "id": "max_width", "min": 300, "max": 800, "step": 50, "label": "Max width (px)", "default": 600 },
    { "type": "range", "id": "border_radius", "min": 0, "max": 24, "step": 4, "label": "Border radius", "default": 8 },
    { "type": "range", "id": "padding_top", "min": 0, "max": 80, "step": 8, "label": "Padding top", "default": 24 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 80, "step": 8, "label": "Padding bottom", "default": 24 },
    { "type": "checkbox", "id": "show_controls", "label": "Show controls", "default": false }
  ],
  "presets": [{ "name": "Blow Dry Video" }]
}
{% endschema %}
