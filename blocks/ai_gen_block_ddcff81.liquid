{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

<style>
  .sim-{{ ai_gen_id }} {
    background: #fff;
    max-width: 480px;
    margin: 0 auto;
    padding: 20px;
    font-family: system-ui, sans-serif;
    text-align: center;
  }
  .sim-img-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    border-radius: 8px;
    display: block;
    margin: 0 auto 20px;
  }
  .sim-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    color: #111;
    margin: 0 0 12px;
    line-height: 1.3;
  }
  .sim-body-{{ ai_gen_id }} {
    font-size: {{ block.settings.body_font_size }}px;
    color: #444;
    line-height: 1.6;
    margin: 0 0 20px;
  }
  .sim-btn-{{ ai_gen_id }} {
    display: inline-block;
    background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    padding: 14px 28px;
    border-radius: 6px;
    font-weight: 700;
    font-size: 15px;
    text-decoration: none;
    border: none;
    cursor: pointer;
  }
  .sim-btn-{{ ai_gen_id }}:hover {
    opacity: 0.9;
  }
</style>

<div class="sim-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.image %}
    <img src="{{ block.settings.image | img_url: 'master' }}"
         alt="{{ block.settings.image.alt | escape }}"
         class="sim-img-{{ ai_gen_id }}"
         loading="lazy">
  {% endif %}
  {% if block.settings.heading != blank %}
    <h2 class="sim-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
  {% endif %}
  {% if block.settings.body_text != blank %}
    <p class="sim-body-{{ ai_gen_id }}">{{ block.settings.body_text }}</p>
  {% endif %}
  {% if block.settings.button_label != blank %}
    <a href="{{ block.settings.button_url }}" class="sim-btn-{{ ai_gen_id }}">
      {{ block.settings.button_label }}
    </a>
  {% endif %}
</div>

{% schema %}
{
  "name": "Single image and text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "body_text", "label": "Body text" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_url", "label": "Button URL" },
    { "type": "color", "id": "button_color", "label": "Button color", "default": "#CC0000" },
    { "type": "color", "id": "button_text_color", "label": "Button text color", "default": "#ffffff" },
    { "type": "range", "id": "heading_size", "min": 16, "max": 48, "step": 1, "label": "Heading size", "default": 24 },
    { "type": "range", "id": "body_font_size", "min": 12, "max": 24, "step": 1, "label": "Body font size", "default": 16 }
  ],
  "presets": [{ "name": "Single image and text" }]
}
{% endschema %}
