{% doc %}
  Create a custom image banner section that displays different images for desktop and mobile
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-dual-banner-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    display: block;
    padding-top: 0px;
  }
  .ai-dual-banner__container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
  }
  .ai-dual-banner__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    display: block;
  }
  .ai-dual-banner__image-wrapper-{{ ai_gen_id }}--desktop {
    display: block;
  }
  .ai-dual-banner__image-wrapper-{{ ai_gen_id }}--mobile {
    display: none;
  }
  .ai-dual-banner__image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }
  .ai-dual-banner__image-{{ ai_gen_id }}--desktop {
    min-height: {{ block.settings.desktop_height }}px;
    max-height: {{ block.settings.desktop_height }}px;
  }
  .ai-dual-banner__image-{{ ai_gen_id }}--mobile {
  min-height: unset;
  max-height: unset;
  height: auto;
}

  .ai-dual-banner__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    background: rgba(0,0,0,{{ block.settings.overlay_opacity | divided_by: 100.0 }});
  }
  .ai-dual-banner__content-{{ ai_gen_id }} {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    width: 90%;
  }
  .ai-dual-banner__heading-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    margin: 0 0 8px;
    line-height: 1.2;
    text-transform: uppercase;
  }
  .ai-dual-banner__subheading-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.subheading_size }}px;
    margin: 0 0 16px;
  }
  .ai-dual-banner__btn-{{ ai_gen_id }} {
    display: inline-block;
    background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    padding: 12px 28px;
    border-radius: 6px;
    font-weight: 700;
    font-size: 14px;
    text-decoration: none;
    border: none;
    cursor: pointer;
  }
  @media (max-width: 749px) {
    .ai-dual-banner__image-wrapper-{{ ai_gen_id }}--desktop { display: none; }
    .ai-dual-banner__image-wrapper-{{ ai_gen_id }}--mobile { display: block; }
    .ai-dual-banner__heading-{{ ai_gen_id }} { font-size: {{ block.settings.heading_size | times: 0.7 | round }}px; }
  }
{% endstyle %}

<div class="ai-dual-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-dual-banner__container-{{ ai_gen_id }}">
    <div class="ai-dual-banner__image-wrapper-{{ ai_gen_id }} ai-dual-banner__image-wrapper-{{ ai_gen_id }}--desktop">
      {% if block.settings.desktop_image %}
        <img src="{{ block.settings.desktop_image | img_url: 'master' }}"
             alt="{{ block.settings.desktop_image.alt | escape }}"
             class="ai-dual-banner__image-{{ ai_gen_id }} ai-dual-banner__image-{{ ai_gen_id }}--desktop"
             loading="eager">
      {% endif %}
    </div>
    <div class="ai-dual-banner__image-wrapper-{{ ai_gen_id }} ai-dual-banner__image-wrapper-{{ ai_gen_id }}--mobile">
      {% if block.settings.mobile_image %}
        <img src="{{ block.settings.mobile_image | img_url: 'master' }}"
             alt="{{ block.settings.mobile_image.alt | escape }}"
             class="ai-dual-banner__image-{{ ai_gen_id }} ai-dual-banner__image-{{ ai_gen_id }}--mobile"
             loading="eager">
      {% else %}
        <img src="{{ block.settings.desktop_image | img_url: 'master' }}"
             alt="{{ block.settings.desktop_image.alt | escape }}"
             class="ai-dual-banner__image-{{ ai_gen_id }} ai-dual-banner__image-{{ ai_gen_id }}--mobile"
             loading="eager">
      {% endif %}
    </div>
    <div class="ai-dual-banner__overlay-{{ ai_gen_id }}"></div>
    <div class="ai-dual-banner__content-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-dual-banner__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}
      {% if block.settings.subheading != blank %}
        <p class="ai-dual-banner__subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
      {% endif %}
      {% if block.settings.button_label != blank %}
        <a href="{{ block.settings.button_url }}" class="ai-dual-banner__btn-{{ ai_gen_id }}">
          {{ block.settings.button_label }}
        </a>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Dual image banner",
  "settings": [
    { "type": "image_picker", "id": "desktop_image", "label": "Desktop image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
    { "type": "range", "id": "desktop_height", "min": 300, "max": 900, "step": 10, "unit": "px", "label": "Desktop height", "default": 750 },
    { "type": "range", "id": "mobile_height", "min": 200, "max": 700, "step": 10, "unit": "px", "label": "Mobile height", "default": 500 },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_url", "label": "Button URL" },
    { "type": "color", "id": "button_color", "label": "Button color", "default": "#CC0000" },
    { "type": "color", "id": "button_text_color", "label": "Button text color", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#ffffff" },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 80, "step": 5, "label": "Overlay opacity", "default": 30 },
    { "type": "range", "id": "heading_size", "min": 20, "max": 80, "step": 2, "label": "Heading size", "default": 40 },
    { "type": "range", "id": "subheading_size", "min": 12, "max": 30, "step": 1, "label": "Subheading size", "default": 18 }
  ],
  "presets": [{ "name": "Dual image banner" }]
}
{% endschema %}
