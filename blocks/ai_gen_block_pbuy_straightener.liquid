<div class="pbuy-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
{%- if product != blank -%}
  {%- assign current_variant = product.selected_or_first_available_variant -%}

  {% assign pbuy_initial_media_index = 0 %}
  {% assign pbuy_first_video_found = false %}

  {%- for media in product.media limit: 8 -%}
    {% if media.media_type == 'video' and pbuy_first_video_found == false %}
      {% assign pbuy_initial_media_index = forloop.index0 %}
      {% assign pbuy_first_video_found = true %}
    {% endif %}
  {%- endfor -%}

  <div class="pbuy-gallery-{{ ai_gen_id }}">
  <div class="pbuy-main-viewport-{{ ai_gen_id }}">
    <span class="pbuy-media-stamp-{{ ai_gen_id }}">{{ block.settings.pbuy_media_stamp | escape }}</span>
    <div
  id="pbuy-main-track-{{ ai_gen_id }}"
  class="pbuy-main-track-{{ ai_gen_id }}"
  style="transform: translateX(-{{ pbuy_initial_media_index | times: 100 }}%);"
>
    {% assign pbuy_main_media_class = 'pbuy-main-image-' | append: ai_gen_id %}

{% assign pbuy_main_media_class = 'pbuy-main-image-' | append: ai_gen_id %}

{%- for media in product.media limit: 8 -%}
  <div class="pbuy-main-slide-{{ ai_gen_id }} pbuy-main-slide--{{ media.media_type }}-{{ ai_gen_id }}" data-index="{{ forloop.index0 }}">
    {%- case media.media_type -%}

      {%- when 'video' -%}
        {{
          media
          | video_tag:
            autoplay: true,
            loop: true,
            muted: true,
            controls: false,
            playsinline: true,
            preload: 'metadata',
            class: pbuy_main_media_class
        }}

      {%- when 'image' -%}
        <img
          class="pbuy-main-image-{{ ai_gen_id }}"
          src="{{ media | image_url: width: 1500 }}"
          alt="{{ media.alt | escape }}"
          loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
        >

      {%- else -%}
        {% if media.preview_image %}
          <img
            class="pbuy-main-image-{{ ai_gen_id }}"
            src="{{ media.preview_image | image_url: width: 1500 }}"
            alt="{{ media.alt | escape }}"
            loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
          >
        {% endif %}

    {%- endcase -%}
  </div>
{%- endfor -%}
    </div>
  </div>

  <div class="pbuy-thumbs-{{ ai_gen_id }}">
   {%- for media in product.media limit: 8 -%}
  {% assign thumb_image = media.preview_image %}
  {% if thumb_image == blank and media.media_type == 'image' %}
    {% assign thumb_image = media %}
  {% endif %}

  {% if thumb_image %}
    <img
      class="pbuy-thumb-{{ ai_gen_id }}{% if forloop.index0 == pbuy_initial_media_index %} active{% endif %}"
      data-index="{{ forloop.index0 }}"
      src="{{ thumb_image | image_url: width: 240 }}"
      alt="{{ media.alt | escape }}"
    >
  {% endif %}
{%- endfor -%}
  </div>
  <div class="pbuy-gallery-ugc-moved-{{ ai_gen_id }}">

  <div style="display:flex;gap:6px;margin:16px 0 14px;width:100%;align-items:stretch;">
      
