<script>
(function() {
  function initGallery() {
  var root = document.querySelector('.pbuy-{{ ai_gen_id }}');
  if (!root) return;

  var mainTrack = root.querySelector('#pbuy-main-track-{{ ai_gen_id }}');
  var viewport = root.querySelector('.pbuy-main-viewport-{{ ai_gen_id }}');
  var thumbs = Array.from(root.querySelectorAll('.pbuy-thumb-{{ ai_gen_id }}'));
  var indicator = root.querySelector('#pbuy-thumb-indicator-{{ ai_gen_id }}');
  var indicatorTrack = root.querySelector('#pbuy-thumb-track-{{ ai_gen_id }}');
  var thumbsStrip = root.querySelector('.pbuy-thumbs-{{ ai_gen_id }}');

  if (!mainTrack || !viewport || !thumbs.length || !indicator || !indicatorTrack) return;

  var activeIndex = parseInt(root.dataset.activeIndex || '{{ pbuy_initial_media_index | default: 0 }}', 10);
  var startX = 0;
  var startY = 0;
  var endX = 0;
  var endY = 0;

  function setTrackPosition(index, animate) {
    activeIndex = Math.max(0, Math.min(index, thumbs.length - 1));
    root.dataset.activeIndex = String(activeIndex);

    if (!animate) {
      mainTrack.style.transition = 'none';
    } else {
      mainTrack.style.transition = 'transform 0.28s ease';
    }

    mainTrack.style.transform = 'translate3d(-' + (activeIndex * 100) + '%, 0, 0)';

    if (!animate) {
      requestAnimationFrame(function() {
        mainTrack.style.transition = 'transform 0.28s ease';
      });
    }

    setActiveThumb(activeIndex);
  }

  function setActiveThumb(index) {
    thumbs.forEach(function(thumb, i) {
      thumb.classList.toggle('active', i === index);
    });

    var activeThumb = thumbs[index];
    if (!activeThumb) return;

    if (thumbsStrip) {
      var targetLeft = activeThumb.offsetLeft - (thumbsStrip.clientWidth / 2) + (activeThumb.offsetWidth / 2);
      thumbsStrip.scrollTo({
        left: Math.max(0, targetLeft),
        behavior: 'smooth'
      });
    }

    var thumbRect = activeThumb.getBoundingClientRect();
    var trackRect = indicatorTrack.getBoundingClientRect();
    indicator.style.width = thumbRect.width + 'px';
    indicator.style.transform = 'translateX(' + (thumbRect.left - trackRect.left) + 'px)';
  }

  if (root.dataset.galleryBound !== 'true') {
    root.dataset.galleryBound = 'true';

    thumbs.forEach(function(thumb) {
      thumb.addEventListener('click', function() {
        var index = parseInt(this.dataset.index || '0', 10);
        setTrackPosition(index, true);
      });
    });

    viewport.addEventListener('touchstart', function(e) {
      if (!e.touches || !e.touches.length) return;
      startX = e.touches[0].clientX;
      startY = e.touches[0].clientY;
      endX = startX;
      endY = startY;
    }, { passive: true });

    viewport.addEventListener('touchmove', function(e) {
      if (!e.touches || !e.touches.length) return;
      endX = e.touches[0].clientX;
      endY = e.touches[0].clientY;
    }, { passive: true });

    viewport.addEventListener('touchend', function() {
      var deltaX = endX - startX;
      var deltaY = endY - startY;

      if (Math.abs(deltaX) > 40 && Math.abs(deltaX) > Math.abs(deltaY)) {
        if (deltaX < 0) {
          setTrackPosition(activeIndex + 1, true);
        } else {
          setTrackPosition(activeIndex - 1, true);
        }
      }
    }, { passive: true });

    window.addEventListener('orientationchange', function() {
      window.setTimeout(function() {
        setTrackPosition(activeIndex, false);
      }, 200);
    });
  }

  setTrackPosition(activeIndex, false);
}
initGallery();
window.addEventListener('load', initGallery);
document.addEventListener('shopify:section:load', initGallery);
})();
</script>
<script>
(function() {
  var sticky = document.querySelector('[data-pbuy-sticky-{{ ai_gen_id }}]');
  var stickyButton = document.querySelector('[data-pbuy-sticky-button-{{ ai_gen_id }}]');
  var mainButton = document.querySelector('#pbuy-form-{{ ai_gen_id }} button[name="add"]');

  if (!sticky || !stickyButton || !mainButton) return;

  function updateSticky() {
    if (window.innerWidth > 749) {
      sticky.classList.remove('is-visible');
      return;
    }

    var rect = mainButton.getBoundingClientRect();
    var shouldShow = rect.bottom < 0;

    sticky.classList.toggle('is-visible', shouldShow);
  }

  stickyButton.addEventListener('click', function() {
    if (mainButton.disabled) return;
    mainButton.click();
  });

  window.addEventListener('scroll', updateSticky, { passive: true });
  window.addEventListener('resize', updateSticky);
  updateSticky();
})();
</script>
<script>
(function() {
  function initThumbHover{{ ai_gen_id }}() {
    var root = document.querySelector('.pbuy-{{ ai_gen_id }}');
    if (!root) return;

    var canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    if (!canHover) return;

    var thumbs = Array.from(root.querySelectorAll('.pbuy-thumb-{{ ai_gen_id }}'));
    if (!thumbs.length) return;

    thumbs.forEach(function(thumb) {
      if (thumb.dataset.hoverBound === 'true') return;
      thumb.dataset.hoverBound = 'true';

      var hoverTimer = null;

      thumb.addEventListener('mouseenter', function() {
        clearTimeout(hoverTimer);

        hoverTimer = setTimeout(function() {
          thumb.click();
        }, 100);
      });

      thumb.addEventListener('mouseleave', function() {
        clearTimeout(hoverTimer);
      });
    });
  }

  initThumbHover{{ ai_gen_id }}();
  window.addEventListener('load', initThumbHover{{ ai_gen_id }});
  document.addEventListener('shopify:section:load', initThumbHover{{ ai_gen_id }});
})();
</script>

