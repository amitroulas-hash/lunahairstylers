{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign pbuy_sticky_variant = product.selected_or_first_available_variant %}

<div class="pbuy-sticky-atc-{{ ai_gen_id }}" data-pbuy-sticky-{{ ai_gen_id }}>
  <div class="pbuy-sticky-atc__copy-{{ ai_gen_id }}">
    <span>{{ block.settings.pbuy_sticky_label | default: product.title | escape }}</span>
    <div>
      <strong>{{ pbuy_sticky_variant.price | money }}</strong>
      {% if pbuy_sticky_variant.compare_at_price > pbuy_sticky_variant.price %}
        <s>{{ pbuy_sticky_variant.compare_at_price | money }}</s>
      {% endif %}
    </div>
  </div>

  <button type="button" class="pbuy-sticky-atc__button-{{ ai_gen_id }}" data-pbuy-sticky-button-{{ ai_gen_id }}>
    Add to Cart
  </button>
</div>
{% style %}
.pbuy-{{ ai_gen_id }} {
  display: block;
  width: 100%;
  background: #fff;
  font-family: inherit;
}

.pbuy-gallery-{{ ai_gen_id }} {
  width: 100%;
  position: relative;
}

 .pbuy-main-viewport-{{ ai_gen_id }} {
  width: 100%;
  max-width: none;
  overflow: hidden;
  position: relative;
}

.pbuy-main-track-{{ ai_gen_id }} {
  display: flex;
  width: 100%;
  transition: transform 0.28s ease;
  will-change: transform;
}

.pbuy-main-slide-{{ ai_gen_id }} {
  flex: 0 0 100%;
}

.pbuy-main-image-{{ ai_gen_id }} {
  width: 100%;
  aspect-ratio: 1 / 1;
  object-fit: cover;
  display: block;
  user-select: none;
  -webkit-user-drag: none;
}
video.pbuy-main-image-{{ ai_gen_id }} {
  height: auto;
  background: #000;
}
.pbuy-thumbs-{{ ai_gen_id }} {
  display: flex;
  gap: 10px;
  padding: 10px 16px 14px;
  overflow-x: auto;
  overflow-y: hidden;
  scroll-snap-type: x mandatory;
  scroll-padding-left: 16px;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
}
.pbuy-thumbs-{{ ai_gen_id }}::-webkit-scrollbar { display: none; }
.pbuy-thumb-{{ ai_gen_id }} {
  width: 72px;
  height: 72px;
  flex-shrink: 0;
  object-fit: cover;
  border-radius: 6px;
  border: 2px solid transparent;
  cursor: pointer;
  scroll-snap-align: start;
  margin-bottom: 6px;
}
.pbuy-thumb-{{ ai_gen_id }}.active {
  border-color: #E6A0AA;
}
.pbuy-thumb-indicator-track-{{ ai_gen_id }} {
  position: relative;
  height: 4px;
  margin: 10px 16px 6px;
  background: rgba(230,160,170,0.12);
  border-radius: 999px;
  overflow: hidden;
}

.pbuy-thumb-indicator-{{ ai_gen_id }} {
  position: absolute;
  left: 0;
  top: 0;
  height: 4px;
  width: 72px;
  background: #E6A0AA;
  border-radius: 999px;
  transition: transform 0.25s ease, width 0.25s ease;
  z-index: 2;
}
.pbuy-info-{{ ai_gen_id }} {
  padding: 16px;
}
.pbuy-title-{{ ai_gen_id }} {
  font-size: 22px;
  font-weight: 700;
  color: #111;
  margin: 0 0 8px;
  line-height: 1.2;
}
.pbuy-subtitle-{{ ai_gen_id }} {
  font-size: 13px;
  color: #666;
  margin: 0 0 12px;
  font-style: italic;
}
.pbuy-review-badge-{{ ai_gen_id }} {
  margin: 0 0 10px;
  line-height: 1;
}

.pbuy-review-badge-{{ ai_gen_id }} .jdgm-preview-badge {
  display: flex;
  align-items: center;
  gap: 6px;
  flex-wrap: wrap;
}

.pbuy-review-badge-{{ ai_gen_id }} .jdgm-star {
  color: #E6A0AA !important;
}

.pbuy-review-badge-{{ ai_gen_id }} .jdgm-prev-badge__text,
.pbuy-review-badge-{{ ai_gen_id }} .jdgm-preview-badge__text {
  color: #666 !important;
  font-size: 13px;
}
.pbuy-price-{{ ai_gen_id }} {
  font-size: 20px;
  font-weight: 600;
  color: #111;
  margin: 0 0 16px;
}
.pbuy-compare-{{ ai_gen_id }} {
  font-size: 14px;
  color: #999;
  text-decoration: line-through;
  margin-left: 8px;
}
.pbuy-variants-{{ ai_gen_id }} {
  margin-bottom: 14px;
}
.pbuy-variants-{{ ai_gen_id }} label {
  font-size: 13px;
  color: #555;
  display: block;
  margin-bottom: 6px;
}
.pbuy-variant-select-{{ ai_gen_id }} {
  width: 100%;
  padding: 10px 12px;
  border: 1px solid #ddd;
  border-radius: 6px;
  font-size: 14px;
  background: #fff;
  color: #111;
}
.pbuy-qty-label-{{ ai_gen_id }} {
  font-size: 13px;
  color: #555;
  margin-bottom: 6px;
}
.pbuy-qty-{{ ai_gen_id }} {
  display: flex;
  align-items: center;
  margin-bottom: 14px;
  border: 1px solid #ddd;
  border-radius: 6px;
  width: fit-content;
}
.pbuy-qty-btn-{{ ai_gen_id }} {
  background: none;
  border: none;
  width: 40px;
  height: 40px;
  font-size: 20px;
  cursor: pointer;
  color: #111;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pbuy-qty-num-{{ ai_gen_id }} {
  width: 40px;
  text-align: center;
  font-size: 15px;
  font-weight: 600;
  border: none;
  outline: none;
  background: none;
}
.pbuy-atc-{{ ai_gen_id }} {
  display: block;
  width: 100%;
  background: #111;
  color: #fff;
  border: none;
  border-radius: 8px;
  padding: 16px;
  font-size: 15px;
  font-weight: 700;
  letter-spacing: 0.5px;
  cursor: pointer;
  margin-bottom: 10px;
  text-transform: uppercase;
}
.pbuy-atc-{{ ai_gen_id }}:hover { background: #333; }
.pbuy-bin-{{ ai_gen_id }} {
  display: block;
  width: 100%;
  background: #e8829a;
  color: #fff;
  border: none;
  border-radius: 8px;
  padding: 14px;
  font-size: 15px;
  font-weight: 700;
  cursor: pointer;
  margin-bottom: 12px;
  text-transform: uppercase;
}
.pbuy-bin-{{ ai_gen_id }}:hover { background: #d4607a; }
.pbuy-trust-{{ ai_gen_id }} {
  font-size: 12px;
  color: #888;
  text-align: center;
  margin: 4px 0 20px;
}
.pbuy-desc-{{ ai_gen_id }} {
  font-size: 14px;
  color: #444;
  line-height: 1.6;
  border-top: 1px solid #eee;
  padding-top: 16px;
}
.pbuy-desc-{{ ai_gen_id }} p { margin: 0 0 10px; }
.pbuy-desc-{{ ai_gen_id }} ul {
  list-style: none;
  padding: 0;
  margin: 0 0 12px;
}
.pbuy-desc-{{ ai_gen_id }} ul li {
  padding: 4px 0 4px 22px;
  position: relative;
  font-size: 14px;
  color: #444;
  line-height: 1.5;
}
.pbuy-desc-{{ ai_gen_id }} ul li::before {
  content: "•";
  position: absolute;
  left: 0;
  color: #e8829a;
  font-size: 18px;
  line-height: 1.3;
}
.pbuy-desc-{{ ai_gen_id }} h2,
.pbuy-desc-{{ ai_gen_id }} h3 {
  font-size: 15px;
  font-weight: 700;
  color: #111;
  margin: 16px 0 8px;
}
.pbuy-reviews-accordion-{{ ai_gen_id }} {
  margin: 16px 0 0;
  border: 1px solid rgba(230,160,170,0.32);
  border-radius: 10px;
  overflow: hidden;
  background: #fff;
}

.pbuy-reviews-summary-{{ ai_gen_id }} {
  list-style: none;
  cursor: pointer;
  padding: 14px 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  background: #FDF4F6;
}

.pbuy-reviews-summary-{{ ai_gen_id }}::-webkit-details-marker {
  display: none;
}

.pbuy-reviews-summary-left-{{ ai_gen_id }} {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.pbuy-reviews-summary-title-{{ ai_gen_id }} {
  font-size: 15px;
  font-weight: 700;
  color: #111;
  line-height: 1.2;
}

.pbuy-reviews-summary-sub-{{ ai_gen_id }} {
  font-size: 12.5px;
  color: #666;
  line-height: 1.2;
}

.pbuy-reviews-summary-icon-{{ ai_gen_id }} {
  font-size: 18px;
  color: #E6A0AA;
  line-height: 1;
  flex-shrink: 0;
  transition: transform 0.22s ease;
}

.pbuy-reviews-accordion-{{ ai_gen_id }}[open] .pbuy-reviews-summary-icon-{{ ai_gen_id }} {
  transform: rotate(180deg);
}

.pbuy-reviews-body-{{ ai_gen_id }} {
  padding: 14px 14px 16px;
  border-top: 1px solid rgba(230,160,170,0.18);
  background: #fff;
}

.pbuy-reviews-body-{{ ai_gen_id }} .jdgm-star {
  color: #E6A0AA !important;
}
.pbuy-reviews-body-{{ ai_gen_id }} .jdgm-rev-widg__title,
.pbuy-reviews-body-{{ ai_gen_id }} .jdgm-widget-title {
  display: none !important;
}

.pbuy-reviews-body-{{ ai_gen_id }} .jdgm-write-rev-link,
.pbuy-reviews-body-{{ ai_gen_id }} .jdgm-btn,
.pbuy-reviews-body-{{ ai_gen_id }} .jdgm-submit-rev {
  background: #E6A0AA !important;
  border-color: #E6A0AA !important;
  color: #fff !important;
  border-radius: 8px !important;
  box-shadow: none !important;
}

.pbuy-reviews-body-{{ ai_gen_id }} .jdgm-sort-dropdown,
.pbuy-reviews-body-{{ ai_gen_id }} .jdgm-question-btn,
.pbuy-reviews-body-{{ ai_gen_id }} .jdgm-ask-question-btn {
  color: #111 !important;
}

.pbuy-reviews-body-{{ ai_gen_id }} .jdgm-histogram__bar-content {
  background: #E6A0AA !important;
}

.pbuy-reviews-body-{{ ai_gen_id }} .jdgm-rev__author,
.pbuy-reviews-body-{{ ai_gen_id }} .jdgm-rev__title {
  color: #111 !important;
  font-weight: 600 !important;
}

.pbuy-reviews-body-{{ ai_gen_id }} .jdgm-rev__body,
.pbuy-reviews-body-{{ ai_gen_id }} .jdgm-rev__timestamp,
.pbuy-reviews-body-{{ ai_gen_id }} .jdgm-rev__icon {
  color: #666 !important;
}
.pbuy-reviews-body-{{ ai_gen_id }} .jdgm-rev__icon,
.pbuy-reviews-body-{{ ai_gen_id }} .jdgm-rev__pic {
  display: none !important;
}

.pbuy-reviews-body-{{ ai_gen_id }} .jdgm-rev__header {
  display: block !important;
}

.pbuy-reviews-body-{{ ai_gen_id }} .jdgm-rev__author-wrapper {
  padding-left: 0 !important;
  margin-left: 0 !important;
}

.pbuy-reviews-body-{{ ai_gen_id }} .jdgm-rev-widg__summary {
  padding: 0 !important;
  margin-bottom: 8px !important;
}

.pbuy-reviews-body-{{ ai_gen_id }} .jdgm-rev-widg__summary-average {
  font-size: 16px !important;
  font-weight: 600 !important;
  color: #111 !important;
}

.pbuy-reviews-body-{{ ai_gen_id }} .jdgm-rev-widg__summary-text {
  font-size: 13px !important;
  color: #666 !important;
}

.pbuy-reviews-body-{{ ai_gen_id }} .jdgm-rev-widg__summary svg,
.pbuy-reviews-body-{{ ai_gen_id }} .jdgm-rev-widg__summary img,
.pbuy-reviews-body-{{ ai_gen_id }} .jdgm-rev-widg__summary [class*="medal"],
.pbuy-reviews-body-{{ ai_gen_id }} .jdgm-rev-widg__summary [class*="badge"],
.pbuy-reviews-body-{{ ai_gen_id }} .jdgm-rev-widg__summary [class*="verified"] {
  display: none !important;
}

.pbuy-reviews-body-{{ ai_gen_id }} .jdgm-histogram {
  margin-top: 6px !important;
  margin-bottom: 10px !important;
}

.pbuy-reviews-body-{{ ai_gen_id }} .jdgm-histogram__row {
  margin-bottom: 6px !important;
}

.pbuy-reviews-body-{{ ai_gen_id }} .jdgm-write-rev-link,
.pbuy-reviews-body-{{ ai_gen_id }} .jdgm-btn,
.pbuy-reviews-body-{{ ai_gen_id }} .jdgm-submit-rev {
  padding-top: 12px !important;
  padding-bottom: 12px !important;
  font-size: 15px !important;
}
.pbuy-reviews-body-{{ ai_gen_id }} .jdgm-paginate {
  display: none !important;
}

.pbuy-load-more-{{ ai_gen_id }} {
  display: none;
  width: 100%;
  margin-top: 16px;
  padding: 14px 16px;
  border: none;
  border-radius: 8px;
  background: #F3D6E0;
  color: #111;
  font-size: 14px;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  cursor: pointer;
}

.pbuy-load-more-{{ ai_gen_id }}:hover {
  opacity: 0.92;
}

.pbuy-load-more-{{ ai_gen_id }}[disabled] {
  opacity: 0.7;
  cursor: default;
}
.pbuy-reviews-body-{{ ai_gen_id }} .jdgm-paginate {
  display: none !important;
}

.pbuy-load-more-{{ ai_gen_id }} {
  display: none;
  width: 100%;
  margin-top: 16px;
  padding: 14px 16px;
  border: none;
  border-radius: 8px;
  background: #F3D6E0;
  color: #111;
  font-size: 14px;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  cursor: pointer;
}

.pbuy-load-more-{{ ai_gen_id }}:hover {
  opacity: 0.92;
}
/* ===== LUNA PDP DESKTOP CLEAN LAYOUT ===== */
@media screen and (min-width: 990px) {
  .pbuy-{{ ai_gen_id }} {
  display: grid !important;
  grid-template-columns: minmax(0, 66%) minmax(340px, 34%);
  column-gap: clamp(48px, 6vw, 110px);
  align-items: start;
  width: 100%;
  max-width: 1600px;
  margin: 0 auto;
  padding: clamp(38px, 4vw, 72px) clamp(40px, 5vw, 90px) 40px;
}

  .pbuy-gallery-{{ ai_gen_id }} {
  grid-column: 1;
  width: 100%;
  max-width: none;
}

  .pbuy-info-{{ ai_gen_id }} {
    grid-column: 2;
    padding: 0;
    width: 100%;
  }

  .pbuy-inner-{{ ai_gen_id }} {
    max-width: 460px;
    margin: 0;
  }

 .pbuy-main-image-{{ ai_gen_id }} {
  aspect-ratio: 1 / 0.78;
  width: 100%;
  height: auto;
  max-height: 620px;
  object-fit: cover;
  background: #fff;
}

  .pbuy-thumbs-{{ ai_gen_id }} {
    padding: 14px 0 12px;
    justify-content: center;
  }
.pbuy-thumbs-{{ ai_gen_id }} {
  border-top: 1px solid #eee;
  padding-top: 16px;
}
  .pbuy-thumb-indicator-track-{{ ai_gen_id }} {
    margin-left: 0;
    margin-right: 0;
  }
.pbuy-inner-{{ ai_gen_id }} > * {
  margin-bottom: 12px;
}

  .pbuy-title-{{ ai_gen_id }} {
    font-size: 28px;
    line-height: 1.08;
    margin-top: 0;
    margin-bottom: 12px;
  }

  .pbuy-price-{{ ai_gen_id }} {
    font-size: 22px;
    margin-bottom: 16px;
  }

  .pbuy-trust-{{ ai_gen_id }} {
    text-align: left;
  }

  .pbuy-desc-{{ ai_gen_id }} {
    margin-top: 18px;
  }

  .pbuy-reviews-accordion-{{ ai_gen_id }} {
    margin-top: 16px;
  }
}
/* ===== LUNA PDP LOWER CONTENT CLEANUP ===== */
@media screen and (min-width: 990px) {
  .pbuy-info-{{ ai_gen_id }} > .pbuy-inner-{{ ai_gen_id }} {
    position: relative;
  }

  .pbuy-desc-{{ ai_gen_id }} {
    border-top: 1px solid rgba(0,0,0,0.08);
    margin-top: 18px;
    padding-top: 18px;
  }

  .pbuy-desc-{{ ai_gen_id }} h2,
  .pbuy-desc-{{ ai_gen_id }} h3 {
    font-size: 15px;
    line-height: 1.25;
    margin: 0 0 8px;
  }

  .pbuy-desc-{{ ai_gen_id }} p,
  .pbuy-desc-{{ ai_gen_id }} li {
    font-size: 14px;
    line-height: 1.55;
  }

  .pbuy-reviews-accordion-{{ ai_gen_id }} {
    margin-top: 14px;
  }

  .pbuy-reviews-summary-{{ ai_gen_id }} {
    min-height: 58px;
  }

  .pbuy-info-{{ ai_gen_id }} div[style*="display:flex"][style*="gap:6px"] {
    gap: 10px !important;
    margin-top: 14px !important;
    margin-bottom: 14px !important;
  }

  .pbuy-info-{{ ai_gen_id }} div[style*="aspect-ratio"],
  .pbuy-info-{{ ai_gen_id }} div[style*="overflow:hidden"] {
    border-radius: 10px !important;
  }

  .pbuy-info-{{ ai_gen_id }} video,
  .pbuy-info-{{ ai_gen_id }} img {
    max-width: 100%;
  }
}

@media screen and (min-width: 1200px) {
  .pbuy-desc-{{ ai_gen_id }},
  .pbuy-reviews-accordion-{{ ai_gen_id }} {
    max-width: 100%;
  }
}
/* ===== LUNA PDP 2.0 — STRAIGHTENER BRAND PASS ===== */

.pbuy-{{ ai_gen_id }} {
  background:
    radial-gradient(circle at 12% 8%, rgba(72, 205, 255, .28) 0, rgba(72, 205, 255, 0) 34%),
