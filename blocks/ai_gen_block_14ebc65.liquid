{% doc %}
  @prompt
    Create a block called "Dual Image Column with Copy" for a Shopify Dawn theme. The block features two 50/50 columns displayed side by side on desktop, stacking to single column on mobile. Each column has: an image on top, a heading below, and body copy below that. Settings per column: separate image picker for desktop and mobile, image height control for desktop (px, range slider) and mobile (px, range slider), image size/fit selector (cover or contain), heading text field, body copy rich text field, optional CTA button label and URL. Section-level settings: background colour picker, padding top (range slider, px), padding bottom (range slider, px), column gap (range slider, px). Dawn-style premium aesthetic — clean, minimal, consistent spacing, no heavy shadows. All settings editable in the Shopify theme editor sidebar.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-dual-image-column-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
  }

  .ai-dual-image-column__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-dual-image-column__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.column_gap }}px;
  }

  .ai-dual-image-column__column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
  }

  .ai-dual-image-column__image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    overflow: hidden;
    margin-bottom: 20px;
  }

  .ai-dual-image-column__image-desktop-{{ ai_gen_id }} {
    width: 100%;
    height: var(--ai-image-height-desktop-{{ ai_gen_id }});
    object-fit: var(--ai-image-fit-{{ ai_gen_id }});
    display: block;
  }

  .ai-dual-image-column__image-mobile-{{ ai_gen_id }} {
    display: none;
  }

  .ai-dual-image-column__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: var(--ai-image-height-desktop-{{ ai_gen_id }});
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-dual-image-column__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-dual-image-column__heading-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: 24px;
    line-height: 1.3;
    margin: 0 0 12px 0;
    color: #000000;
  }

  .ai-dual-image-column__body-{{ ai_gen_id }} {
    font-size: 16px;
    line-height: 1.6;
    margin: 0 0 20px 0;
    color: #000000;
  }

  .ai-dual-image-column__body-{{ ai_gen_id }} p {
    margin: 0 0 12px 0;
  }

  .ai-dual-image-column__body-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-dual-image-column__cta-{{ ai_gen_id }} {
    display: inline-block;
    padding: 12px 24px;
    background-color: #000000;
    color: #ffffff;
    text-decoration: none;
    border-radius: 0;
    font-size: 14px;
    font-weight: 500;
    transition: opacity 0.2s ease;
    border: 1px solid #000000;
  }

  .ai-dual-image-column__cta-{{ ai_gen_id }}:hover {
    opacity: 0.8;
  }

  @media screen and (max-width: 749px) {
    .ai-dual-image-column__grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .ai-dual-image-column__image-desktop-{{ ai_gen_id }} {
      display: none;
    }

    .ai-dual-image-column__image-mobile-{{ ai_gen_id }} {
      display: block;
      width: 100%;
      height: var(--ai-image-height-mobile-{{ ai_gen_id }});
      object-fit: var(--ai-image-fit-{{ ai_gen_id }});
    }

    .ai-dual-image-column__placeholder-{{ ai_gen_id }} {
      height: var(--ai-image-height-mobile-{{ ai_gen_id }});
    }

    .ai-dual-image-column__heading-{{ ai_gen_id }} {
      font-size: 20px;
    }

    .ai-dual-image-column__body-{{ ai_gen_id }} {
      font-size: 14px;
    }
  }
{% endstyle %}

<dual-image-column-{{ ai_gen_id }} class="ai-dual-image-column-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-dual-image-column__container-{{ ai_gen_id }}">
    <div class="ai-dual-image-column__grid-{{ ai_gen_id }}">
      <div
        class="ai-dual-image-column__column-{{ ai_gen_id }} ai-dual-image-column__column-1-{{ ai_gen_id }}"
        style="
          --ai-image-height-desktop-{{ ai_gen_id }}: {{ block.settings.column_1_image_height_desktop }}px;
          --ai-image-height-mobile-{{ ai_gen_id }}: {{ block.settings.column_1_image_height_mobile }}px;
          --ai-image-fit-{{ ai_gen_id }}: {{ block.settings.column_1_image_fit }};
        "
      >
        <div class="ai-dual-image-column__image-wrapper-{{ ai_gen_id }}">
          {% if block.settings.column_1_image_desktop %}
            <img
              src="{{ block.settings.column_1_image_desktop | image_url: width: 800 }}"
              alt="{{ block.settings.column_1_image_desktop.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.column_1_image_desktop.width }}"
              height="{{ block.settings.column_1_image_desktop.height }}"
              class="ai-dual-image-column__image-desktop-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-dual-image-column__placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}

          {% if block.settings.column_1_image_mobile %}
            <img
              src="{{ block.settings.column_1_image_mobile | image_url: width: 600 }}"
              alt="{{ block.settings.column_1_image_mobile.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.column_1_image_mobile.width }}"
              height="{{ block.settings.column_1_image_mobile.height }}"
              class="ai-dual-image-column__image-mobile-{{ ai_gen_id }}"
            >
          {% elsif block.settings.column_1_image_desktop %}
            <img
              src="{{ block.settings.column_1_image_desktop | image_url: width: 600 }}"
              alt="{{ block.settings.column_1_image_desktop.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.column_1_image_desktop.width }}"
              height="{{ block.settings.column_1_image_desktop.height }}"
              class="ai-dual-image-column__image-mobile-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-dual-image-column__placeholder-{{ ai_gen_id }} ai-dual-image-column__image-mobile-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>

        {% if block.settings.column_1_heading != blank %}
          <h3 class="ai-dual-image-column__heading-{{ ai_gen_id }}">{{ block.settings.column_1_heading }}</h3>
        {% endif %}

        {% if block.settings.column_1_body != blank %}
          <div class="ai-dual-image-column__body-{{ ai_gen_id }}">{{ block.settings.column_1_body }}</div>
        {% endif %}

        {% if block.settings.column_1_cta_label != blank and block.settings.column_1_cta_url != blank %}
          <a href="{{ block.settings.column_1_cta_url }}" class="ai-dual-image-column__cta-{{ ai_gen_id }}">
            {{ block.settings.column_1_cta_label }}
          </a>
        {% endif %}
      </div>

      <div
        class="ai-dual-image-column__column-{{ ai_gen_id }} ai-dual-image-column__column-2-{{ ai_gen_id }}"
        style="
          --ai-image-height-desktop-{{ ai_gen_id }}: {{ block.settings.column_2_image_height_desktop }}px;
          --ai-image-height-mobile-{{ ai_gen_id }}: {{ block.settings.column_2_image_height_mobile }}px;
          --ai-image-fit-{{ ai_gen_id }}: {{ block.settings.column_2_image_fit }};
        "
      >
        <div class="ai-dual-image-column__image-wrapper-{{ ai_gen_id }}">
          {% if block.settings.column_2_image_desktop %}
            <img
              src="{{ block.settings.column_2_image_desktop | image_url: width: 800 }}"
              alt="{{ block.settings.column_2_image_desktop.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.column_2_image_desktop.width }}"
              height="{{ block.settings.column_2_image_desktop.height }}"
              class="ai-dual-image-column__image-desktop-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-dual-image-column__placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}

          {% if block.settings.column_2_image_mobile %}
            <img
              src="{{ block.settings.column_2_image_mobile | image_url: width: 600 }}"
              alt="{{ block.settings.column_2_image_mobile.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.column_2_image_mobile.width }}"
              height="{{ block.settings.column_2_image_mobile.height }}"
              class="ai-dual-image-column__image-mobile-{{ ai_gen_id }}"
            >
          {% elsif block.settings.column_2_image_desktop %}
            <img
              src="{{ block.settings.column_2_image_desktop | image_url: width: 600 }}"
              alt="{{ block.settings.column_2_image_desktop.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.column_2_image_desktop.width }}"
              height="{{ block.settings.column_2_image_desktop.height }}"
              class="ai-dual-image-column__image-mobile-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-dual-image-column__placeholder-{{ ai_gen_id }} ai-dual-image-column__image-mobile-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>

        {% if block.settings.column_2_heading != blank %}
          <h3 class="ai-dual-image-column__heading-{{ ai_gen_id }}">{{ block.settings.column_2_heading }}</h3>
        {% endif %}

        {% if block.settings.column_2_body != blank %}
          <div class="ai-dual-image-column__body-{{ ai_gen_id }}">{{ block.settings.column_2_body }}</div>
        {% endif %}

        {% if block.settings.column_2_cta_label != blank and block.settings.column_2_cta_url != blank %}
          <a href="{{ block.settings.column_2_cta_url }}" class="ai-dual-image-column__cta-{{ ai_gen_id }}">
            {{ block.settings.column_2_cta_label }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</dual-image-column-{{ ai_gen_id }}>

<script>
  (function() {
    class DualImageColumn{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.adjustImageFit();
      }

      adjustImageFit() {
        const columns = this.querySelectorAll('.ai-dual-image-column__column-{{ ai_gen_id }}');
        columns.forEach((column) => {
          const imageFit = getComputedStyle(column).getPropertyValue('--ai-image-fit-{{ ai_gen_id }}').trim();
          const images = column.querySelectorAll('img');
          images.forEach((img) => {
            img.style.objectFit = imageFit;
          });
        });
      }
    }

    customElements.define('dual-image-column-{{ ai_gen_id }}', DualImageColumn{{ ai_gen_id }});
  })();
</script>

