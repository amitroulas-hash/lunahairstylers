{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

<style>
  .bp-{{ ai_gen_id }} {
    background: {{ block.settings.bg_color }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    margin: {{ block.settings.margin_vertical }}px 0;
    font-family: system-ui, sans-serif;
  }
  .bp-heading-{{ ai_gen_id }} {
    font-size: 13px;
    font-weight: 600;
    color: {{ block.settings.heading_color }};
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0 0 4px;
  }
  .bp-body-{{ ai_gen_id }} {
    font-size: 12px;
    font-weight: 400;
    color: {{ block.settings.body_color }};
    line-height: 1.5;
    margin: 0;
  }
</style>

<div class="bp-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <p class="bp-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</p>
  <p class="bp-body-{{ ai_gen_id }}">{{ block.settings.body }}</p>
</div>

{% schema %}
{
  "name": "Bundle Promo",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bundle & Save 30%" },
    { "type": "textarea", "id": "body", "label": "Body copy", "default": "Add any second Luna product to your cart and get 30% off automatically at checkout — no code needed." },
    { "type": "color", "id": "bg_color", "label": "Background colour", "default": "#F9E8E8" },
    { "type": "color", "id": "heading_color", "label": "Heading colour", "default": "#2C2C2C" },
    { "type": "color", "id": "body_color", "label": "Body colour", "default": "#555555" },
    { "type": "range", "id": "border_radius", "min": 0, "max": 20, "step": 2, "label": "Border radius", "default": 8 },
    { "type": "range", "id": "padding_vertical", "min": 8, "max": 32, "step": 2, "label": "Padding vertical", "default": 12 },
    { "type": "range", "id": "padding_horizontal", "min": 8, "max": 32, "step": 2, "label": "Padding horizontal", "default": 16 },
    { "type": "range", "id": "margin_vertical", "min": 0, "max": 24, "step": 2, "label": "Margin top & bottom", "default": 12 }
  ],
  "presets": [{ "name": "Bundle Promo" }]
}
{% endschema %}
